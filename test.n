}

i64 test_complex_expression()
{
    i64 x;
    i64 y;
    i64 z;
    i64 w;
    i64 e;
    i64 f;
    i64 g;
    i64 result;

    x = 5;
    y = 2;
    z = 3;
    w = 1;
    e = 3;
    f = 1;
    g = 2;

    i64* px;
    px = &x;

    result = (((*px * y / z + w - 1) << 2) >> 1) & e ^ f | g;
    if(result == 3)
    {
        ret 0;
    }
    ret 1;
}

