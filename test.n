i32 add(i32 a, i32 b)
{
    ret a + b;
}

i32 test_function()
{
    if(add(32, add(1, 1)) == 34)
    {
        ret 0;
    }
    ret 1;
}

i32 test_pointers()
{
    i32* p;
    i32** pp;
    i32*** ppp;

    i32 value;
    value = 42;

    p = &value;
    pp = &p;
    ppp = &pp;

    ***ppp = ***ppp - 1;
    **pp = **pp - 1;
    *p = *p - 1;

    if(value == 39)
    {
        ret 0;
    }
    ret 1;
}

i32 test_loop_ret()
{
    i32 i;
    i = 10;
    while(i >= 0)
    {
        if(i == 0)
        {
            ret i;
        }
        i = i - 1;
    }
    ret 1;
}

i32 test_break()
{
    i32 i;
    i = 0;
    while(i < 10)
    {
        if(i == 3)
        {
            break;
        }
        i = i + 1;
    }
    if(i == 3)
    {
        ret 0;
    }
    ret 1;
}

i32 test_continue()
{
    i32 i;
    i = 0;

    i32 out;
    out = 0;

    while(i < 10)
    {
        i = i + 1;
        if(i <= 5)
        {
            continue;
        }
        out = out + 1;
    }
    if(out == 5)
    {
        ret 0;
    }
    ret 1;
}

i32 test_if_0()
{
    if(0 == 0)
    {
        ret 0;
    }
    ret 1;
}

i32 test_if_1()
{
    if(0 == 1)
    {
    }
    else
    {
        ret 0;
    }
    ret 1;
}

i32 test_if_2()
{
    if(0 == 1)
    {
    }
    else if(1 == 1)
    {
        ret 0;
    }
    else
    {
    }
    ret 1;
}

i32 test_if_3()
{
    if(0 == 1)
    {
    }
    else if(2 == 1)
    {
    }
    else if(1 == 1)
    {
        ret 0;
    }
    else
    {
    }
    ret 1;
}

i32 test_if_4()
{
    if(0 == 1)
        ret 1;
    else if(2 == 1)
        ret 1;
    else if(1 == 1)
        ret 0;
    else
        ret 1;
    ret 1;
}

i32 test_nest()
{
    {
        {
            {
                i32 x;
            }
            i32 x;
        }
        i32 x;
    }
    i32 x;
    x = 0;
    ret x;
}

i32 test_recursion(i32 x)
{
    if(x == 0)
    {
        ret 0;
    }
    ret test_recursion(x - 1);
}

i32 set_to_zero(i32* x)
{
    *x = 0;
    ret 0;
}

i32 dont_set_to_above_zero(i32 x)
{
    x = 42;
    ret 0;
}

i32 test_pointer_arg_0()
{
    i32 x;
    x = 42;
    set_to_zero(&x);
    ret x;
}

i32 test_pointer_arg_1()
{
    i32 x;
    x = 0;
    dont_set_to_above_zero(x);
    ret x;
}

i32 test_chain()
{
    i32 x;
    i32 y;
    i32 z;

    x = y = z = 42;

    if(x == 42 & y == 42 & z == 42)
    {
        ret 0;
    }
    ret 1;
}

i32 test_pointer_chain()
{
    i32 x;
    i32 y;
    i32 z;

    i32* px;
    i32* py;
    i32* pz;

    px = &x;
    py = &y;
    pz = &z;

    *px = *py = *pz = 42;

    if(x == 42 & y == 42 & z == 42)
    {
        ret 0;
    }
    ret 1;
}

i32 test_bitwise()
{
    i32 x;
    x = 1 & 2 & 3 & 4;

    i32 y;
    y = 1 | 2 | 3 | 4;

    i32 z;
    z = 1 ^ 2 ^ 3 ^ 4;

    i32 a;
    a = ~255;

    if(x == 0 & y == 7 & z == 4 & a == -256)
    {
        ret 0;
    }
    ret 1;
}

i32 test_shift()
{
    i32 x;
    x = 1 << 8;

    i32 y;
    y = 8;
    y = y >> 1;

    i32 z;
    z = -8;
    z = z >> 1;

    i32 a;
    a = -8;
    a = a << 1;

    if(x == 256 & y == 4 & z == -4 & a == -16)
    {
        ret 0;
    }
    ret 1;
}

i32 test_comparison()
{
    i32 x;
    i32 y;

    x = 1;
    y = 2;

    if(y > x & x < y & y >= 2 & x <= 1 & y >= 1 & x <= 2)
    {
        ret 0;
    }
    ret 1;
}

i32 test_equality()
{
    i32 x;
    i32 y;

    x = 1;
    y = 2;

    if(x == 1 & y == 2 & x != 2 & y != 1 & !(x == y))
    {
        ret 0;
    }
    ret 1;
}

i32 test_complex_expression()
{
    i32 x;
    i32 y;
    i32 z;
    i32 w;
    i32 e;
    i32 f;
    i32 g;
    i32 result;

    x = 5;
    y = 2;
    z = 3;
    w = 1;
    e = 3;
    f = 1;
    g = 2;

    i32* px;
    px = &x;

    result = (((*px * y / z + w - 1) << 2) >> 1) & e ^ f | g;
    if(result == 3)
    {
        ret 0;
    }

    ret 1;
}

i32 test_negative()
{
    i32 x;
    x = -5;
    x = -x;
    x = -x;
    if(x == +5)
    {
        ret 1;
    }
    if(x == 5)
    {
        ret 1;
    }
    if(x == -5)
    {
        ret 0;
    }
    ret 1;
}

i32 test_negative_loop()
{
    i32 loops;
    loops = 0;

    i32 i;
    i = -5;
    while(i < 10)
    {
        loops = loops + 1;
        i = i + 1;
    }

    if(loops == 15)
    {
        ret 0;
    }
    ret 1;
}

i32 main()
{
    ret test_function()
      | test_pointers()
      | test_break()
      | test_continue()
      | test_if_0()
      | test_if_1()
      | test_if_2()
      | test_if_3()
      | test_if_4()
      | test_nest()
      | test_loop_ret()
      | test_recursion(42)
      | test_pointer_arg_0()
      | test_pointer_arg_1()
      | test_chain()
      | test_pointer_chain()
      | test_bitwise()
      | test_shift()
      | test_comparison()
      | test_equality()
      | test_complex_expression()
      | test_negative()
      | test_negative_loop()
      ;
}
