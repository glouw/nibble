i64 test_array_index()
{
    i64 elems;
    i64 size_per;
    i64* as;

    elems = 4;
    size_per = sizeof *as;
    as = <i64*>(malloc(elems * size_per));

    as[0] = 1;
    as[1] = 2;
    as[2] = 3;
    as[3] = 4;

    if(as[0] == 1
     & as[1] == 2
     & as[2] == 3
     & as[3] == 4)
    {
        free(<ptr>(as));
        ret 0;
    }

    free(<ptr>(as));
    ret 1;
}

i64 test_array_loop_index()
{
    i64 elems;
    i64 size_per;
    i64* as;
    i64 i;
    i64 sum;
    i64 fill;

    elems = 32;
    size_per = sizeof *as;
    as = <i64*>(malloc(elems * size_per));

    fill = 1;
    i = 0;
    while(i < elems)
    {
        as[i] = fill;
        i = i + 1;
    }

    sum = 0;
    i = 0;
    while(i < elems)
    {
        sum = sum + as[i];
        i = i + 1;
    }

    if(sum == elems * fill)
    {
        free(<ptr>(as));
        ret 0;
    }

    free(<ptr>(as));
    ret 1;
}

