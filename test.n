      | test_pointer_arg_1()
      | test_chain()
      | test_pointer_chain()
      | test_bitwise()
      | test_shift()
      | test_comparison()
      | test_equality()
      | test_complex_expression()
      | test_negative()
      | test_negative_loop()
      | test_generic_ptr()
      | test_llabs()
      | test_bool_param(1 == 1, 2 == 2, 3 == 3)
      | test_array_index()
      | test_array_loop_index()
      | test_generic_indirect()
      | test_sizeof()
      | test_new()
      | test_new_indirect()
      | test_new_many()
      | test_zero_init()
      | test_continue()
      | test_break()
      | test_defer_0()
      | test_defer_1()
      | test_defer_2()
      | test_defer_3()
      | test_defer_4()
      | test_defer_5()
      | test_defer_6()
      | test_defer_7()
