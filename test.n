i64 test_new_many()
{
    i64 value;
    value = 4;

    i64 elems;
    elems = 512;

    i64 total;
    total = elems * value;

    i64* array;
    array = new i64 [elems];

    i64 sum;

    {
        i64 i;
        while(i < elems)
        {
            array[i] = value;
            i = i + 1;
        }
    }

    {
        i64 i;
        while(i < elems)
        {
            sum = sum + array[i];
            i = i + 1;
        }
    }

    if(sum == total)
    {
        del array;
        ret 0;
    }

    del array;
    ret 1;
}

