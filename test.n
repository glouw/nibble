i64 test_direct_function_deref()
{
    i1 true = 1 == 1;
    i1 false = !true;

    i64* p = new i64;
    defer del p;

    i1 okay = true;

    //
    // ensure functions pointers are lvalue convertable
    //

    *pass_pointer(p) = 42;
    if(*p != 42)
        okay = false;

    **pass_pointer_pointer(&p) = 11;
    if(*p != 11)
        okay = false;

    if(okay)
    {
        ret 0;
    }
    ret 1;
}

