i64** new_2d_array(i64 ysize, i64 xsize)
{
    i64** y = new i64*[ysize];
    i64 i = 0;
    while(i < ysize)
    {
        y[i] = new i64[xsize];
        i = i + 1;
    }
    ret y;
}

void del_2d_array(i64** array, i64 ysize)
{
    i64 i = 0;
    while(i < ysize)
    {
        del array[i];
        i = i + 1;
    }
    del array;
    ret;
}

i64 test_2d_array()
{
    i64 ysize = 128;
    i64 xsize = 32;
    i64** array = new_2d_array(ysize, xsize);
    defer del_2d_array(array, ysize);
    ret 0;
}

