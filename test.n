i64 test_bitwise()
{
    i64 x;
    x = 1 & 2 & 3 & 4;

    i64 y;
    y = 1 | 2 | 3 | 4;

    i64 z;
    z = 1 ^ 2 ^ 3 ^ 4;

    i64 a;
    a = ~255;

    if(x == 0 & y == 7 & z == 4 & a == -256)
    {
        ret 0;
    }
    ret 1;
}

i64 test_shift()
{
    i64 x;
    x = 1 << 8;

    i64 y;
    y = 8;
    y = y >> 1;

    i64 z;
    z = -8;
    z = z >> 1;

    i64 a;
    a = -8;
    a = a << 1;

    if(x == 256 & y == 4 & z == -4 & a == -16)
    {
        ret 0;
    }
    ret 1;
}

