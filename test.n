{
    i64 value;
};

type array_t
{
    int_t* value;
};

type blob_t
{
    i32 a;
    i1 c;
    i8 d;
    i16 e;
    i64 f;
    int_t int;
    array_t array;
};

i64 test_type_copy()
{
    blob_t a;
    blob_t b;
    blob_t* p = &a;

    a.f = 42;

    a.int.value = 42;

    int_t other = a.int;

    b = *p;

    blob_t c;
    c.array.value = new int_t[32];
    defer del c.array.value;

    int_t* temp = c.array.value;
    temp[4].value = 42;

    if(a.f == 42
     & b.f == 42
     & other.value == 42
     & a.int.value == 42
     & temp[4].value == 42
     & c.array.value[4].value == 42
     )
    {
        ret 0;
    }

    ret 1;
}

i64 test_type_access()
{
    blob_t* heap = new blob_t;
    defer del heap;

    blob_t stack;

    heap.f = 42; // automatic deref, no need to struggle with ->
    stack.f = 42;

    if(heap.f == 42 & stack.f == 42)
    {
        ret 0;
    }

    ret 1;
}

type str_t
{
    i8* data;
    i64 size;
};

i64 test_putchar()
{
    i8* string = "test";
    i8* str = new i8[8];
    defer del str;
    str[0] = <i8>(104);
    str[1] = <i8>(101);
    str[2] = <i8>(108);
    str[3] = <i8>(108);
    str[4] = <i8>(111);
    str[5] = <i8>( 10);
    str[6] = <i8>(  0);
    i64 len = 6;
    i64 i;
    while(i < len)
    {
        putchar(<i32>(str[i]));
        i = i + 1;
    }
    ret 0;
}

str_t str_init(i8* data)
{
    str_t self;
    while(data[self.size] != <i8>(0))
    {
        self.size = self.size + 1;
    }
    self.data = new i8[self.size + 1];
    i64 i;
    while(i < self.size)
    {
        self.data[i] = data[i];
        i = i + 1;
    }
    self.data[self.size] = <i8>(0);
    ret self;
}

void str_cat(str_t* self, str_t* other)
{
    str_t out;
    out.size = self.size + other.size;
    out.data = new i8[out.size + 1];
    i64 index;
    i64 i;
    while(i < self.size)
    {
        out.data[index] = self.data[i];
        index = index + 1;
        i = i + 1;
    }
    i64 j;
    while(j < other.size)
    {
        out.data[index] = other.data[j];
        index = index + 1;
        j = j + 1;
    }
    out.data[index] = <i8>(0);
    del self.data;
    *self = out;
    ret;
}

void str_print(str_t* self)
{
    i64 i;
    while(i < self.size)
    {
        putchar(<i32>(self.data[i]));
        i = i + 1;
    }
    ret;
}

i64 test_str()
{
    str_t message = str_init("test test test");
    str_t a = str_init(" ");
    str_t b = str_init("this");
    str_t c = str_init(" ");
    str_t d = str_init("\tmessage\nx\nx\nx\n");
    defer del message.data;
    defer del a.data;
    defer del b.data;
    defer del c.data;
    defer del d.data;

    str_cat(&message, &a);
    str_cat(&message, &b);
    str_cat(&message, &c);
    str_cat(&message, &d);

    str_print(&message);

    ret 0;
}

void test_type_no_change(int_t int)
{
    int.value = 42;
    ret;
}

void test_type_change(int_t* int)
{
    int.value = 42;
    ret;
}

i64 test_type_pass()
{
    int_t int;
    test_type_no_change(int);
    if(int.value == 42)
    {
        ret 1;
    }
    test_type_change(&int);
    if(int.value == 0)
    {
        ret 1;
    }
    ret 0;
}

i32 main()
{
    ret <i32> (
        test_function()
      | test_pointers()
      | test_if_0()
      | test_if_1()
      | test_if_2()
      | test_if_3()
      | test_if_4()
      | test_nest()
      | test_loop_ret()
