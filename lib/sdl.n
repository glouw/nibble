type sdl_rect_t
{
    i32 x;
    i32 y;
    i32 w;
    i32 h;
};

type sdl_point_t
{
    i32 x;
    i32 y;
};

type sdl_scancode_t
{
    i64 escape = 41;
    i64 capslock = 57;
    i64 end = 77;
};

i32 SDL_Init(u32 flags);
i32 SDL_SetRenderDrawColor(ptr renderer, u8 r, u8 g, u8 b, u8 a);
i32 SDL_RenderClear(ptr renderer);
ptr SDL_CreateWindow(i8* title, i32 x, i32 y, i32 w, i32 h, u32 flags);
ptr SDL_CreateRenderer(ptr window, i32 index, u32 flags);
i32 SDL_RenderFillRect(ptr renderer, sdl_rect_t* rect);
void SDL_DestroyWindow(ptr window);
void SDL_Quit();
void SDL_Delay(u32 ms);
void SDL_DestroyRenderer(ptr renderer);
void SDL_RenderPresent(ptr renderer);
ptr SDL_RWFromFile(i8* path, i8* mode);
ptr SDL_LoadBMP_RW(ptr source, i32 close_stream);
void SDL_FreeSurface(ptr surface);
ptr SDL_CreateTextureFromSurface(ptr renderer, ptr surface);
ptr SDL_CreateTexture(ptr renderer, u32 format, i32 access, i32 w, i32 h);
void SDL_DestroyTexture(ptr texture);
i32 SDL_RenderCopy(ptr renderer, ptr texture, sdl_rect_t* source, sdl_rect_t* dest);
i32 SDL_RenderCopyEx(ptr renderer, ptr texture, sdl_rect_t* source, sdl_rect_t* dest, double angle, sdl_point_t* center, i32 flip);
u8* SDL_GetKeyboardState(i8* numkeys);
void SDL_PumpEvents();
u32 SDL_GetMouseState(i32* x, i32* y);
i32 SDL_LockTexture(ptr texture, sdl_rect_t* rect, ptr* pixels, i32* pitch);
void SDL_UnlockTexture(ptr texture);
u32 SDL_GetTicks();
i32 SDL_GetCPUCount();
i64 SDL_RenderDrawLine(ptr renderer, i64 x1, i64 y1, i64 x2, i64 y2);

type sdl_t
{
    i64 xres;
    i64 yres;
    i64 xmid;
    i64 ymid;
    i8* name;
    i64 margin = 8;
    ptr window;
    ptr renderer;
};

sdl_t
sdl_init(i64 xres, i64 yres, i8* name)
{
    u32 init_video = <u32>(32);
    SDL_Init(init_video);
    sdl_t self;
    self.xres = xres;
    self.yres = yres;
    self.xmid = xres / 2;
    self.ymid = yres / 2;
    self.name = name;
    self.window = SDL_CreateWindow(
        self.name,
        <i32>(0),
        <i32>(0),
        <i32>(self.xres),
        <i32>(self.yres),
        <u32>(0)
    );
    u32 accelerated = <u32>(2);
    u32 vsync = <u32>(4);
    self.renderer= SDL_CreateRenderer(self.window, <i32>(-1), accelerated | vsync);
    ret self;
}

void
sdl_del(sdl_t* self)
{
    SDL_DestroyRenderer(self.renderer);
    SDL_DestroyWindow(self.window);
    SDL_Quit();
    ret;
}

void
sdl_set_render_draw_color(sdl_t* self, i64 r, i64 g, i64 b, i64 a)
{
    SDL_SetRenderDrawColor(self.renderer, <u8>(r), <u8>(g), <u8>(b), <u8>(a));
    ret;
}

void
sdl_render_draw_line(sdl_t* self, i64 x1, i64 y1, i64 x2, i64 y2)
{
    SDL_RenderDrawLine(self.renderer, x1, y1, x2, y2);
    ret;
}

void
sdl_clear_screen(sdl_t* self)
{
    sdl_set_render_draw_color(self, 0, 0, 0, 0);
    SDL_RenderClear(self.renderer);
    ret;
}

void
sdl_present(sdl_t* self)
{
    SDL_RenderPresent(self.renderer);
    ret;
}

void
sdl_delay(i64 ms)
{
    if(ms > 0)
    {
        SDL_Delay(<u32>(ms));
    }
    ret;
}

ptr
sdl_load_bmp(i8* path)
{
    ptr data = SDL_RWFromFile(path, "rb");
    i32 close_stream = <i32>(1); // yes, close it.
    ptr bmp = SDL_LoadBMP_RW(data, close_stream);
    if(bmp == <ptr>(0))
    {
        printf("could not open %s\n", path);
        exit(<i32>(1));
    }
    ret bmp;
}

void
sdl_del_bmp(ptr surface)
{
    SDL_FreeSurface(surface);
    ret;
}

ptr
sdl_surface_to_texture(sdl_t* self, ptr surface)
{
    ptr texture = SDL_CreateTextureFromSurface(self.renderer, surface);
    ret texture;
}

void
sdl_destroy_texture(ptr texture)
{
    SDL_DestroyTexture(texture);
    ret;
}

void
sdl_render_copy(sdl_t* self, ptr texture, sdl_rect_t* source, sdl_rect_t* dest)
{
    SDL_RenderCopy(self.renderer, texture, source, dest);
    ret;
}

void
sdl_render_copy_ex(sdl_t* self, ptr texture, sdl_rect_t* source, sdl_rect_t* dest, i32 flip)
{
    SDL_RenderCopyEx(self.renderer, texture, source, dest, 0.0, <sdl_point_t*>(0), flip);
    ret;
}

void
sdl_pump_events()
{
    SDL_PumpEvents();
    ret;
}

u8*
sdl_get_keyboard_state()
{
    sdl_pump_events();
    ret SDL_GetKeyboardState(<i8*>(0));
}

i64
sdl_get_mouse_state(i64* x, i64* y)
{
    sdl_pump_events();
    i32 xx;
    i32 yy;
    i64 out = <i64>(SDL_GetMouseState(&xx, &yy));
    *x = <i64>(xx);
    *y = <i64>(yy);
    ret out;
}

i1
sdl_is_key_down(i64 key)
{
    u8* state = sdl_get_keyboard_state();
    ret <i64>(state[key]) == 1;
}

i1
sdl_is_done()
{
    sdl_scancode_t scancode;
    ret sdl_is_key_down(scancode.end)
      | sdl_is_key_down(scancode.escape)
      | sdl_is_key_down(scancode.capslock)
    ;
}

void sdl_lock_texture(ptr texture, sdl_rect_t* rect, ptr* pixels, i32* pitch)
{
    SDL_LockTexture(texture, rect, pixels, pitch);
    ret;
}

void sdl_unlock_texture(ptr texture)
{
    SDL_UnlockTexture(texture);
    ret;
}

type sdl_stream_t
{
    ptr texture;
    u32* buffer;
    i32 pitch;
};

sdl_stream_t
sdl_stream_init(sdl_t* self)
{
    sdl_stream_t stream;
    u32 pixel_format_argb8888 = <u32>(372645892);
    i32 texure_access_streaming = <i32>(1);
    stream.texture = SDL_CreateTexture(
        self.renderer,
        pixel_format_argb8888,
        texure_access_streaming,
        <i32>(self.xres),
        <i32>(self.yres)
    );
    ret stream;
}

void
sdl_lock_stream(sdl_stream_t* self)
{
    sdl_lock_texture(self.texture, <sdl_rect_t*>(0), <ptr*>(&self.buffer), &self.pitch);
    ret;
}

void
sdl_send_stream(sdl_stream_t* self, sdl_t* sdl)
{
    sdl_unlock_texture(self.texture);
    sdl_render_copy(sdl, self.texture, <sdl_rect_t*>(0), <sdl_rect_t*>(0));
    ret;
}

void
sdl_stream_del(sdl_stream_t* self)
{
    sdl_destroy_texture(self.texture);
    ret;
}

double
sdl_mod(double x, double y)
{
    ret x - y * floor(x / y);
}

type sdl_vec2
{
    double x;
    double y;
};

sdl_vec2
sdl_vec2_init(double x, double y)
{
    sdl_vec2 self;
    self.x = x;
    self.y = y;
    ret self;
}

double
sdl_len2(sdl_vec2 self)
{
    self = self * self;
    ret sqrt(self.x + self.y);
}

sdl_vec2
sdl_mod2(sdl_vec2 a, sdl_vec2 b)
{
    sdl_vec2 self;
    self.x = sdl_mod(a.x, b.x);
    self.y = sdl_mod(a.y, b.y);
    ret self;
}

sdl_vec2
sdl_exp2(sdl_vec2 self)
{
    self.x = exp(self.x);
    self.y = exp(self.y);
    ret self;
}

double sdl_fract(double x)
{
    ret x - floor(x);
}

sdl_vec2 sdl_fract2(sdl_vec2 a)
{
    sdl_vec2 self;
    self.x = sdl_fract(a.x);
    self.y = sdl_fract(a.y);
    ret self;
}

sdl_vec2
sdl_mod2s(sdl_vec2 self, double scalar)
{
    self.x = sdl_mod(self.x, scalar);
    self.y = sdl_mod(self.y, scalar);
    ret self;
}

sdl_vec2
sdl_mul2s(sdl_vec2 self, double scalar)
{
    self.x = self.x * scalar;
    self.y = self.y * scalar;
    ret self;
}

sdl_vec2
sdl_div2s(sdl_vec2 self, double scalar)
{
    self.x = self.x / scalar;
    self.y = self.y / scalar;
    ret self;
}

sdl_vec2
sdl_sub2s(sdl_vec2 self, double scalar)
{
    self.x = self.x - scalar;
    self.y = self.y - scalar;
    ret self;
}

type sdl_vec3
{
    double x;
    double y;
    double z;
};

sdl_vec3
sdl_vec3_init(double x, double y, double z)
{
    sdl_vec3 self;
    self.x = x;
    self.y = y;
    self.z = z;
    ret self;
}

sdl_vec3
sdl_cos3(sdl_vec3 vec)
{
    sdl_vec3 self;
    self.x = cos(vec.x);
    self.y = cos(vec.y);
    self.z = cos(vec.z);
    ret self;
}

sdl_vec3
sdl_mul3s(sdl_vec3 self, double scalar)
{
    self.x = self.x * scalar;
    self.y = self.y * scalar;
    self.z = self.z * scalar;
    ret self;
}

type sdl_vec4
{
    double r;
    double g;
    double b;
    double a;
};

sdl_vec4
sdl_vec4_init(double r, double g, double b, double a)
{
    sdl_vec4 self;
    self.r = r;
    self.g = g;
    self.b = b;
    self.a = a;
    ret self;
}

double
sdl_clamp(double x, double min, double max)
{
    if(x < min) ret min;
    if(x > max) ret max;
    ret x;
}

sdl_vec4
sdl_clamp_vec4(sdl_vec4 color)
{
    color.r = sdl_clamp(color.r, 0.0, 1.0);
    color.g = sdl_clamp(color.g, 0.0, 1.0);
    color.b = sdl_clamp(color.b, 0.0, 1.0);
    color.a = sdl_clamp(color.a, 0.0, 1.0);
    ret color;
}

void
sdl_stream_put(sdl_stream_t* self, sdl_t* sdl, i64 x, i64 y, sdl_vec4 color)
{
    double max = 255.0;
    i64 a_bit = 24;
    i64 r_bit = 16;
    i64 g_bit = 8;
    i64 b_bit = 0;
    color = sdl_clamp_vec4(color);
    i64 r = <i64>(color.r * max);
    i64 g = <i64>(color.g * max);
    i64 b = <i64>(color.b * max);
    i64 a = <i64>(color.a * max);
    i64 pixel = (a << a_bit) | (r << r_bit) | (g << g_bit) | (b << b_bit);
    self.buffer[sdl.xres * y + x] = <u32>(pixel);
    ret;
}

double
sdl_get_seconds()
{
    double ms = <double>(SDL_GetTicks());
    double ms_per_second = 1000.0;
    ret ms / ms_per_second;
}

i64
sdl_get_cpu_count()
{
    ret <i64>(SDL_GetCPUCount());
}

type sdl_average_t
{
    double* array;
    i64 size;
    i64 cap;
};

sdl_average_t
sdl_average_init(i64 cap)
{
    sdl_average_t self;
    self.cap = cap;
    self.array = new double[self.cap];
    ret self;
}

double
sdl_average_get(sdl_average_t* self)
{
    if(self.size == 0)
    {
        ret 0.0;
    }
    double total;
    i64 i;
    while(i < self.size)
    {
        total = total + self.array[i];
        i++;
    }
    ret total / <double>(self.size);
}

void
sdl_average_push(sdl_average_t* self, double value)
{
    if(self.size == self.cap)
    {
        i64 i;
        while(i < self.size - 1)
        {
            self.array[i] = self.array[i + 1];
            i++;
        }
        self.array[self.size - 1] = value;
    }
    else
    {
        self.array[self.size] = value;
        self.size++;
    }
    ret;
}

void
sdl_average_del(sdl_average_t* self)
{
    del self.array;
    ret;
}

type sdl_font_t
{
    ptr surface;
    ptr texture;
    i64 zoom;
    i64 xtiles;
    i64 ytiles;
    i64 tile_width;
    i64 tile_height;
};

sdl_font_t
sdl_font_init(sdl_t* sdl, i8* path, i64 zoom, i64 xtiles, i64 ytiles, i64 tile_width, i64 tile_height)
{
    sdl_font_t self;
    self.surface = sdl_load_bmp(path);
    self.texture = sdl_surface_to_texture(sdl, self.surface);
    self.zoom = zoom;
    self.xtiles = xtiles;
    self.ytiles = ytiles;
    self.tile_width = tile_width;
    self.tile_height = tile_height;
    ret self;
}

void
sdl_font_del(sdl_font_t* self)
{
    sdl_del_bmp(self.surface);
    sdl_destroy_texture(self.texture);
    ret;
}

sdl_rect_t
sdl_font_get_source_rect(sdl_font_t* self, i8 ch)
{
    i64 index = <i64>(ch);
    i64 x = index % self.xtiles;
    i64 y = index / self.xtiles;
    sdl_rect_t rect;
    rect.x = <i32>(x * self.tile_width);
    rect.y = <i32>(y * self.tile_height);
    rect.w = <i32>(self.tile_width);
    rect.h = <i32>(self.tile_height);
    ret rect;
}

sdl_rect_t
sdl_font_get_dest_rect(sdl_font_t* self, i64 x, i64 y)
{
    sdl_rect_t rect;
    rect.x = <i32>(x);
    rect.y = <i32>(y);
    rect.w = <i32>(self.zoom * self.tile_width);
    rect.h = <i32>(self.zoom * self.tile_height);
    ret rect;
}

i64
sdl_write_font(sdl_t* sdl, sdl_font_t* self, i8* message, i64 x, i64 y)
{
    i8 ch;
    i64 i;
    i64 begin = x;
    sdl_rect_t dest;
    sdl_rect_t source;
    while(<i1>(1))
    {
        dest = sdl_font_get_dest_rect(self, x, y);
        ch = message[i];
        if(ch == '\0')
        {
            y = y + <i64>(dest.h);
            break;
        }
        source = sdl_font_get_source_rect(self, ch);
        if(ch == '\n')
        {
            y = y + <i64>(dest.h);
            x = begin;
        }
        else
        {
            sdl_render_copy_ex(sdl, self.texture, &source, &dest, <i32>(0));
            x = x + <i64>(dest.w);
        }
        i++;
    }
    ret y;
}

void
sdl_write_fps(sdl_t* self, sdl_font_t* font, sdl_average_t* average)
{
    i8* buffer = new i8[128];
    defer del buffer;
    double fps = sdl_average_get(average);
    i32...() indirect = sprintf;
    i64 chars = <i64>(indirect(buffer, "FPS %4.1f", fps));
    sdl_rect_t size = sdl_font_get_dest_rect(font, 0, 0);
    i64 x = self.xres - chars * <i64>(size.w) - self.margin;
    i64 y = self.margin;
    sdl_write_font(self, font, buffer, x, y);
    ret;
}

type sdl_scroll_t
{
    i64 x;
    i64 y;
};

sdl_scroll_t
sdl_scroll_init(sdl_t* sdl)
{
    sdl_scroll_t self;
    self.x = sdl.margin;
    self.y = sdl.margin;
    ret self;
}

void
sdl_scroll_write(sdl_scroll_t* self, sdl_t* sdl, sdl_font_t* font, i8* message)
{
    self.y = sdl_write_font(sdl, font, message, self.x, self.y);
    ret;
}
