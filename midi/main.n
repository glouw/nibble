    //    Track_Spin(track, 2);
    //    break;
    //}
    //// Controller.
    //case 0xB:
    //{
    //    uint8_t type = Track_U8(track);
    //    uint8_t value = Track_U8(track);
    //    switch(type)
    //    {
    //        case 0x07:
    //            meta->volume[channel] = value / 127.0f;
    //            break;
    //        default:
    //            break;
    //    }
    //    break;
    //}
    //// Program Change.
    //case 0xC:
    //{
    //    uint8_t program = Track_U8(track);
    //    meta->instruments[channel] = program;
    //    break;
    //}
    //// Channel Aftertouch.
    //case 0xD:
