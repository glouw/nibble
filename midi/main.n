include "../lib/std.n";

type constants_t
{
    float pi = 3.14159265358979323846;
    i32 note_attack = 4;
    i32 note_amplification = 15;
    i32 notes_max = 128;
    i32 channel_max = 16;
    i32 note_decay = 512;
    i32 bend_default = 8192;
    i32 sample_freq = 44100;
    i32 video_samples = 2048;
    i32 video_grain = 5;
    i32 modulation_gain = 512;
    i32 bank_width = 8;
};

type track_t
{
    u8* data;
    u32 id;
    u32 size;
    u32 index;
    u32 number;
    i32 delay;
    u8 running_status;
    i1 run;
};

type meta_t
{
    u32 tempo;
    i32* instruments;
    i32* bend;
    float* volume;
};

type note_t
{
    i32 gain;
    i32 gain_setpoint;
    i32 progress;
    i32 bend_last;
    i32 cycle;
    float id;
    i1 on;
    i1 wait;
    i1 was_init;
};

void
track_back(track_t* self)
{
    self.index = self.index - u32 1;
    ret;
}

void
track_next(track_t* self)
{
    self.index = self.index + u32 1;
    ret;
}

u8
track_u8(track_t* self)
{
    u8 byte = self.data[u64 self.index];
    track_next(self);
    ret byte;
}

void
track_spin(track_t* self, i32 size)
{
    while(size-- != 0)
    {
        track_u8(self);
    }
    ret;
}

u32
track_var(track_t* self)
{
    u32 var = u32 0;
    i1 run = i1 1;
    while(run)
    {
        u8 byte = track_u8(self);
        var = u32 (var << u32 7) | u32 (byte & u8 127);
        run = i1 (byte >> u8 7);
    }
    ret var;
}

i8*
track_str(track_t* self)
{
    u8 len = track_u8(self);
    i8* str = new i8[u64 len + u64 1];
    u8 i = u8 0;
    while(i < len)
    {
        str[u64 i] = i8 track_u8(self);
        i++;
    }
    str[u64 len] = '\0';
    ret str;
}

type bytes_t
{
    u8* data;
    u32 size;
};

bytes_t
track_bytes(track_t* self)
{
    bytes_t bytes;
    bytes.size = track_var(self);
    bytes.data = new u8[u64 bytes.size];
    u32 i;
    while(i < bytes.size)
    {
        bytes.data[u64 i] = track_u8(self);
        i++;
    }
    ret bytes;
}

u8
track_status(track_t* self, u8 status)
{
    if((status >> u8 3) == u8 1)
    {
        self.running_status = status;
        ret status;
    }
    track_back(self);
    ret self.running_status;
}

i1
is_percussive(u8 channel)
{
    ret channel == u8 9;
}

void
track_real_event(track_t* self, meta_t* meta, note_t** notes, u8 leader)
{
    u8 channel = leader & u8 15;
    u8 status = track_status(self, leader >> u8 4);
    if(status == u8 8)
    {
        u8 note_index = track_u8(self);
        track_u8(self);
        if(!is_percussive(channel))
        {
            note_t* note = &notes[u64 channel][u64 note_index];
            note.gain_setpoint = 0;
            //meta->bend[channel] = CONST_BEND_DEFAULT;
