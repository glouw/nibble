include "sdl.n";

type point_t
{
    i64 x;
    i64 y;
};

type sprite_sheet_t
{
    ptr surface;
    ptr texture;
    i64 tile_width;
    i64 tile_height;
    i64 frames;
    i64 states;
};

sprite_sheet_t
sprite_sheet_init(sdl_t* sdl, i8* path, i64 tile_width, i64 tile_height, i64 frames, i64 states)
{
    sprite_sheet_t self;
    self.surface = sdl_load_bmp(path);
    self.texture = sdl_surface_to_texture(sdl, self.surface);
    self.tile_width = tile_width;
    self.tile_height = tile_height;
    self.frames = frames;
    self.states = states;
    ret self;
}

void
sprite_sheet_del(sprite_sheet_t* self)
{
    sdl_del_bmp(self.surface);
    sdl_destroy_texture(self.texture);
    ret;
}

type chicken_t
{
    i64 black;
    i64 white;
    i64 brown;
};

type sprite_tag_t
{
    chicken_t chicken;
};

type sprite_state_t
{
    i64 idle;
    i64 walk;
};

type scancode_t
{
    i64 end;
};

type globals_t
{
    sprite_tag_t sprite_tag;
    sprite_state_t sprite_state;
    scancode_t scancode;
};

globals_t
globals_init()
{
    globals_t self;
    self.sprite_tag.chicken.black = 0;
    self.sprite_tag.chicken.white = 1;
    self.sprite_tag.chicken.brown = 2;
    self.sprite_state.idle = 0;
    self.sprite_state.walk = 1;
    self.scancode.end = 77;
    ret self;
}

type sprite_sheets_t
{
    sprite_sheet_t[] sheet;
    i64 size;
    i64 cap;
};

sprite_sheets_t
sprite_sheets_init()
{
    sprite_sheets_t self;
    self.cap = 32;
    self.sheet = new sprite_sheet_t[self.cap];
    ret self;
}

void
sprite_sheets_push(sprite_sheets_t* self, sprite_sheet_t sprite_sheet)
{
    if(self.size == self.cap)
    {
        puts("sprite book full");
        exit(<i32>(1));
    }
    self.sheet[self.size++] = sprite_sheet;
    ret;
}

void
sprite_sheets_del(sprite_sheets_t* self)
{
    del self.sheet;
    ret;
}

type sprite_t
{
    point_t where;
    point_t velocity;
    i64 state;
    i64 frame;
    i64 of_type;
    i64 zoom;
    i64 cycle;
};

sprite_t
sprite_init(i64 x, i64 y, i64 state, i64 frame, i64 of_type, i64 zoom)
{
    sprite_t self;
    self.where.x = x;
    self.where.y = y;
    self.state = state;
    self.frame = frame;
    self.of_type = of_type;
    self.zoom = zoom;
    ret self;
}

type sprites_t
{
    sprite_t[] sprite;
    i64 size;
    i64 cap;
};

sprites_t
sprites_init()
{
    sprites_t self;
    self.cap = 512;
    self.sprite = new sprite_t[self.cap];
    ret self;
}

void
sprites_push(sprites_t* self, sprite_t sprite)
{
    if(self.size == self.cap)
    {
        puts("sprites full");
        exit(<i32>(1));
    }
    self.sprite[self.size++] = sprite;
    ret;
}

void
sprites_sort(sprite_t[] a, i64 lo, i64 hi)
{
    if(lo >= hi)
    {
        ret;
    }
    i64 pivot = a[hi].where.y;
    i64 i = lo;
    i64 j = lo;
    while(j < hi)
    {
        if(a[j].where.y <= pivot)
        {
            sprite_t tmp = a[i];
            a[i] = a[j];
            a[j] = tmp;
            i++;
        }
        j++;
    }
    sprite_t tmp = a[i];
    a[i] = a[hi];
    a[hi] = tmp;
    sprites_sort(a, lo, i - 1);
    sprites_sort(a, i + 1, hi);
    ret;
}

void
sprites_del(sprites_t* sprites)
{
    del sprites.sprite;
    ret;
}

void
sprite_set_walk_state(sprite_t* sprite)
{
    i64 shift = sprite.zoom / 2;
    sprite.velocity.x = <i64>(rand()) % sprite.zoom - shift;
    sprite.velocity.y = <i64>(rand()) % sprite.zoom - shift;
    ret;
}

void
sprite_set_idle_state(sprite_t* sprite)
{
    sprite.velocity.x = 0;
    sprite.velocity.y = 0;
    ret;
}

void
sprite_move(sprite_t* sprite, sdl_t* sdl, sprite_sheets_t* sheets)
{
    sprite_sheet_t* sheet = &sheets.sheet[sprite.of_type];
    i64 x = sprite.where.x;
    i64 y = sprite.where.y;
    sprite.where.x = sprite.where.x + sprite.velocity.x;
    sprite.where.y = sprite.where.y + sprite.velocity.y;
    i64 w = sprite.zoom * sheet.tile_width;
    i64 h = sprite.zoom * sheet.tile_height;
    if(sprite.where.x > sdl.xres - w) sprite.where.x = x;
    if(sprite.where.y > sdl.yres - h) sprite.where.y = y;
    if(x < 0) sprite.where.x = x;
    if(y < 0) sprite.where.y = y;
    ret;
}

void
sprite_set_state(sprite_t* sprite, sprite_sheets_t* sheets, globals_t* globals)
{
    if(sprite.cycle == 0)
    {
        sprite_sheet_t* sheet = &sheets.sheet[sprite.of_type];
        i64 state = <i64>(rand()) % 2; // sheet.states; .. update later
        if(state == globals.sprite_state.idle)
        {
            sprite_set_idle_state(sprite);
            sprite.cycle = 20;
            sprite.state = globals.sprite_state.idle;
        }
        if(state == globals.sprite_state.walk)
        {
            sprite_set_walk_state(sprite);
            sprite.cycle = 30;
            sprite.state = globals.sprite_state.idle; // update to walk later.
        }
    }
    else
    {
        sprite.cycle--;
    }
    ret;
}

void
sprites_move(sprites_t* sprites, sdl_t* sdl, sprite_sheets_t* sheets, globals_t* globals)
{
    i64 index = 0;
    while(index < sprites.size)
    {
        sprite_t* sprite = &sprites.sprite[index];
        sprite_set_state(sprite, sheets, globals);
        sprite_move(sprite, sdl, sheets);
        index++;
    }
    ret;
}

void
sprites_render(sdl_t* sdl, sprites_t* sprites, sprite_sheets_t* sheets, i64 cycle)
{
    i64 index = 0;
    while(index < sprites.size)
    {
        sprite_t* sprite = &sprites.sprite[index];
        sprite_sheet_t* sheet = &sheets.sheet[sprite.of_type];
        sdl_rect_t source;
        {
            i64 frame = sprite.frame % sheet.frames;
            i64 state = sprite.state % sheet.states;
            i64 x = sheet.tile_width * frame;
            i64 y = sheet.tile_height * state;
            source.x = <i32>(x);
            source.y = <i32>(y);
            source.w = <i32>(sheet.tile_width);
            source.h = <i32>(sheet.tile_height);
        }

        sdl_rect_t dest;
        {
            i64 w = sprite.zoom * sheet.tile_width;
            i64 h = sprite.zoom * sheet.tile_height;
            dest.x = <i32>(sprite.where.x);
            dest.y = <i32>(sprite.where.y);
            dest.w = <i32>(w);
            dest.h = <i32>(h);
        }

        i32 flip;
        if(sprite.velocity.x < 0)
            flip = <i32>(0);
        else
            flip = <i32>(1);

        sdl_render_copy_ex(sdl, sheet.texture, &source, &dest, flip);

        if(cycle % 10 == 0)
        {
            sprite.frame++;
        }

        index++;
    }
    ret;
}

i32 main()
{
    sdl_t sdl = sdl_init(1024, 768);
    defer sdl_del(&sdl);

    globals_t globals = globals_init();

    sprite_sheets_t sheets = sprite_sheets_init();
    {
        sprite_sheets_push(&sheets, sprite_sheet_init(&sdl, "black_chicken.bmp", 32, 32, 3, 1));
        sprite_sheets_push(&sheets, sprite_sheet_init(&sdl, "white_chicken.bmp", 32, 32, 3, 1));
        sprite_sheets_push(&sheets, sprite_sheet_init(&sdl, "brown_chicken.bmp", 32, 32, 3, 1));
    }
    defer sprite_sheets_del(&sheets);

    sprites_t sprites = sprites_init();
    {
        sprites_push(&sprites, sprite_init(  0,   0, 0, 0, globals.sprite_tag.chicken.black, 7));
        sprites_push(&sprites, sprite_init(100, 100, 0, 2, globals.sprite_tag.chicken.white, 7));
        sprites_push(&sprites, sprite_init(200, 200, 0, 1, globals.sprite_tag.chicken.brown, 7));
        sprites_push(&sprites, sprite_init(300, 200, 0, 0, globals.sprite_tag.chicken.brown, 7));
        sprites_push(&sprites, sprite_init(400, 200, 0, 0, globals.sprite_tag.chicken.white, 7));
        sprites_push(&sprites, sprite_init(440, 280, 0, 0, globals.sprite_tag.chicken.black, 7));
        sprites_push(&sprites, sprite_init(600, 270, 0, 0, globals.sprite_tag.chicken.black, 7));
        sprites_push(&sprites, sprite_init(700, 270, 0, 0, globals.sprite_tag.chicken.white, 7));
    }
    defer sprites_del(&sprites);

    i64 cycle = 0;
    while(1 == 1)
    {
        if(<i64>(sdl_get_keyboard_state()[globals.scancode.end]) == 1)
        {
            break;
        }
        sprites_move(&sprites, &sdl, &sheets, &globals);
        sprites_sort(sprites.sprite, 0, sprites.size - 1);
        sdl_clear_screen(&sdl);
        sprites_render(&sdl, &sprites, &sheets, cycle);
        sdl_present(&sdl);
        sdl_delay(10);
        cycle++;
    }

    ret <i32>(0);
}
