include "sdl.n";

type point_t
{
    i64 x;
    i64 y;
};

point_t
point_add(point_t a, point_t b)
{
    point_t self;
    self.x = a.x + b.x;
    self.y = a.y + b.y;
    ret self;
}

type sheet_t
{
    ptr surface;
    ptr texture;
    i64 tile_width;
    i64 tile_height;
    i64 frames;
    i64 states;
};

sheet_t
sheet_init(sdl_t* sdl, i8* path, i64 tile_width, i64 tile_height, i64 frames, i64 states)
{
    sheet_t self;
    self.surface = sdl_load_bmp(path);
    self.texture = sdl_surface_to_texture(sdl, self.surface);
    self.tile_width = tile_width;
    self.tile_height = tile_height;
    self.frames = frames;
    self.states = states;
    ret self;
}

void
sheet_del(sheet_t* self)
{
    sdl_del_bmp(self.surface);
    sdl_destroy_texture(self.texture);
    ret;
}

type chicken_t
{
    i64 black;
    i64 white;
    i64 brown;
};

type nest_t
{
    i64 brown;
};

type sprite_tag_t
{
    chicken_t chicken;
    nest_t nest;
};

type sprite_state_t
{
    i64 idle;
    i64 walk;
    i64 sleep;
};

type sprite_state_cycles_t
{
    i64 idle;
    i64 walk;
    i64 sleep;
};

type sprite_state_roll_cap_t
{
    i64 idle;
    i64 walk;
    i64 sleep;
};

type scancode_t
{
    i64 end;
};

type glob_t
{
    sprite_tag_t sprite_tag;
    sprite_state_t sprite_state;
    sprite_state_t sprite_state_cycles;
    sprite_state_t sprite_state_roll_cap;
    scancode_t scancode;
    i1 true;
    i1 false;
    i64 percent_cap;
};

glob_t
glob_init()
{
    glob_t self;
    self.sprite_tag.chicken.black = 0;
    self.sprite_tag.chicken.white = 1;
    self.sprite_tag.chicken.brown = 2;
    self.sprite_tag.nest.brown = 3;
    self.sprite_state.idle = 0;
    self.sprite_state.walk = 1;
    self.sprite_state.sleep = 2;
    self.sprite_state_cycles.idle = 30;
    self.sprite_state_cycles.walk = 40;
    self.sprite_state_cycles.sleep = 500;
    self.sprite_state_roll_cap.idle = 20;
    self.sprite_state_roll_cap.walk = 98;
    self.sprite_state_roll_cap.sleep = 100;
    self.scancode.end = 77;
    self.true = 1 == 1;
    self.false = !self.true;
    self.percent_cap = 100;
    ret self;
}

type sheets_t
{
    sheet_t[] sheet;
    i64 size;
    i64 cap;
};

sheets_t
sheets_init()
{
    sheets_t self;
    self.cap = 32;
    self.sheet = new sheet_t[self.cap];
    ret self;
}

void
sheets_push(sheets_t* self, sheet_t sheet)
{
    assert(self.size < self.cap, "sheets was full");
    self.sheet[self.size++] = sheet;
    ret;
}

void
sheets_del(sheets_t* self)
{
    del self.sheet;
    ret;
}

type sprite_t
{
    point_t where;
    point_t velocity;
    i64 state;
    i64 frame;
    i64 tag;
    i64 zoom;
    i64 cycle;
    i1 is_facing_right;
};

sprite_t
sprite_init(i64 x, i64 y, i64 tag, i64 zoom)
{
    assert(zoom % 2 == 0, "sprite zoom must be even");
    sprite_t self;
    self.where.x = x;
    self.where.y = y;
    self.tag = tag;
    self.zoom = zoom;
    ret self;
}

type sprites_t
{
    sprite_t[] sprite;
    i64 size;
    i64 cap;
};

sprites_t
sprites_init()
{
    sprites_t self;
    self.cap = 512;
    self.sprite = new sprite_t[self.cap];
    ret self;
}

void
sprites_push(sprites_t* self, sprite_t sprite)
{
    assert(self.size < self.cap, "sprites was full");
    self.sprite[self.size++] = sprite;
    ret;
}

void
sprite_swap(sprite_t* self, sprite_t* other)
{
    sprite_t temp = *self;
    *self = *other;
    *other = temp;
    ret;
}

sheet_t*
sprite_get_sheet(sheets_t* self, i64 tag)
{
    ret &self.sheet[tag];
}

point_t
sprite_get_true_size(sprite_t* self, sheets_t* sheets)
{
    sheet_t* sheet = sprite_get_sheet(sheets, self.tag);
    point_t point;
    point.x = self.zoom * sheet.tile_width;
    point.y = self.zoom * sheet.tile_height;
    ret point;
}

sdl_rect_t
sprite_get_dest_rect(sprite_t* self, sheets_t* sheets)
{
    sheet_t* sheet = sprite_get_sheet(sheets, self.tag);
    point_t size = sprite_get_true_size(self, sheets);
    sdl_rect_t rect;
    rect.x = <i32>(self.where.x);
    rect.y = <i32>(self.where.y);
    rect.w = <i32>(size.x);
    rect.h = <i32>(size.y);
    ret rect;
}

i64
sprite_get_bot_y(sprite_t* self, sheets_t* sheets)
{
    sdl_rect_t rect = sprite_get_dest_rect(self, sheets);
    ret <i64>(rect.y + rect.h);
}

void
sprite_sort(sprite_t[] self, i64 lo, i64 hi, sheets_t* sheets)
{
    if(lo >= hi)
    {
        ret;
    }
    sprite_t* pivot = &self[hi];
    i64 i = lo;
    i64 j = lo;
    while(j < hi)
    {
        defer j++;
        sprite_t* test = &self[j];
        if(sprite_get_bot_y(test, sheets) <= sprite_get_bot_y(pivot, sheets))
        {
            sprite_swap(&self[i], &self[j]);
            i++;
        }
    }
    sprite_swap(&self[i], &self[hi]);
    sprite_sort(self, lo, i - 1, sheets);
    sprite_sort(self, i + 1, hi, sheets);
    ret;
}

void
sprites_sort(sprites_t* self, sheets_t* sheets)
{
    sprite_sort(self.sprite, 0, self.size - 1, sheets);
    ret;
}

void
sprites_del(sprites_t* self)
{
    del self.sprite;
    ret;
}

void
sprite_set_idle_state(sprite_t* self, glob_t* glob)
{
    point_t zero;
    self.velocity = zero;
    self.cycle = glob.sprite_state_cycles.idle;
    ret;
}

void
sprite_set_walk_state(sprite_t* self, glob_t* glob)
{
    i64 shift = self.zoom / 2;
    self.velocity.x = <i64>(rand()) % (self.zoom + 1) - shift;
    self.velocity.y = <i64>(rand()) % (self.zoom + 1) - shift;
    self.cycle = glob.sprite_state_cycles.walk;
    ret;
}

void
sprite_set_sleep_state(sprite_t* self, glob_t* glob)
{
    point_t zero;
    self.velocity = zero;
    self.cycle = glob.sprite_state_cycles.sleep;
    ret;
}

sdl_rect_t
sprite_get_source_rect(sprite_t* self, sheets_t* sheets, glob_t* glob)
{
    sheet_t* sheet = sprite_get_sheet(sheets, self.tag);
    i64 frame = self.frame % sheet.frames;
    i64 state = self.state % sheet.states;
    sdl_rect_t rect;
    rect.x = <i32>(sheet.tile_width * frame);
    rect.y = <i32>(sheet.tile_height * state);
    rect.w = <i32>(sheet.tile_width);
    rect.h = <i32>(sheet.tile_height);
    ret rect;
}

i1
sprite_is_out_of_bounds(sprite_t* self, sdl_t* sdl, sheets_t* sheets)
{
    point_t size = sprite_get_true_size(self, sheets);
    ret self.where.x > sdl.xres - size.x
      | self.where.y > sdl.yres - size.y
      | self.where.x < 0
      | self.where.y < 0;
}

i1
sprite_can_walk(sprite_t* self, sheets_t* sheets, glob_t* glob)
{
    i64 states = sprite_get_sheet(sheets, self.tag).states;
    ret states > glob.sprite_state.walk;
}

void
sprite_move(sprite_t* self, sdl_t* sdl, sheets_t* sheets, glob_t* glob)
{
    if(sprite_can_walk(self, sheets, glob))
    {
        point_t revert = self.where;
        self.where = point_add(self.where, self.velocity);
        if(sprite_is_out_of_bounds(self, sdl, sheets))
        {
            self.where = revert;
        }
        if(self.state != glob.sprite_state.sleep)
        {
            self.is_facing_right = self.velocity.x > 0;
        }
    }
    ret;
}

i64
sprite_roll_state(sprite_t* self, glob_t* glob)
{
    i64 state;
    i64 roll = <i64>(rand()) % glob.percent_cap;
    if(roll < glob.sprite_state_roll_cap.idle)
        state = glob.sprite_state.idle;
    else
    if(roll < glob.sprite_state_roll_cap.walk)
        state = glob.sprite_state.walk;
    else
    if(roll < glob.sprite_state_roll_cap.sleep)
        state = glob.sprite_state.sleep;
    ret state;
}

void
sprite_set_state(sprite_t* self, sheets_t* sheets, glob_t* glob)
{
    if(self.cycle == 0)
    {
        sheet_t* sheet = sprite_get_sheet(sheets, self.tag);
        i64 state = sprite_roll_state(self, glob);
        if(state == glob.sprite_state.idle)
            sprite_set_idle_state(self, glob);
        else
        if(state == glob.sprite_state.walk)
            sprite_set_walk_state(self, glob);
        else
        if(state == glob.sprite_state.sleep)
            sprite_set_sleep_state(self, glob);
        else
            abort("unknown sprite state encountered");
        self.state = state;
    }
    else
    {
        self.cycle--;
    }
    ret;
}

void
sprites_move(sprites_t* self, sdl_t* sdl, sheets_t* sheets, glob_t* glob)
{
    i64 i = 0;
    while(i < self.size)
    {
        defer i++;
        sprite_t* sprite = &self.sprite[i];
        sprite_set_state(sprite, sheets, glob);
        sprite_move(sprite, sdl, sheets, glob);
    }
    ret;
}

void
sprites_render(sprites_t* self, sdl_t* sdl, sheets_t* sheets, glob_t* glob, i64 cycle)
{
    i64 i = 0;
    while(i < self.size)
    {
        defer i++;
        sprite_t* sprite = &self.sprite[i];
        sdl_rect_t source = sprite_get_source_rect(sprite, sheets, glob);
        sdl_rect_t dest = sprite_get_dest_rect(sprite, sheets);
        i32 flip;
        if(sprite.is_facing_right)
        {
            flip = <i32>(1);
        }
        sdl_render_copy_ex(sdl, sheets.sheet[sprite.tag].texture, &source, &dest, flip);
        if(cycle % 10 == 0)
        {
            sprite.frame++;
        }
    }
    ret;
}

sheets_t
populate_sheets(sdl_t* sdl)
{
    sheets_t self = sheets_init();
    sheets_push(&self, sheet_init(sdl, "black_chicken.bmp", 32, 32, 3, 3));
    sheets_push(&self, sheet_init(sdl, "white_chicken.bmp", 32, 32, 3, 3));
    sheets_push(&self, sheet_init(sdl, "brown_chicken.bmp", 32, 32, 3, 3));
    sheets_push(&self, sheet_init(sdl, "brown_nest.bmp",    32, 32, 2, 1));
    ret self;
}

sprites_t
populate_sprites(sdl_t* sdl, glob_t* glob)
{
    sprites_t self = sprites_init();
    sprites_push(&self, sprite_init(  0,   0, glob.sprite_tag.chicken.black, 4));
    sprites_push(&self, sprite_init(100, 100, glob.sprite_tag.chicken.white, 8));
    sprites_push(&self, sprite_init(200, 200, glob.sprite_tag.chicken.brown, 4));
    sprites_push(&self, sprite_init(300, 200, glob.sprite_tag.chicken.brown, 6));
    sprites_push(&self, sprite_init(400, 200, glob.sprite_tag.chicken.white, 4));
    sprites_push(&self, sprite_init(440, 280, glob.sprite_tag.chicken.black, 6));
    sprites_push(&self, sprite_init(600, 270, glob.sprite_tag.chicken.black, 4));
    sprites_push(&self, sprite_init(700, 270, glob.sprite_tag.chicken.white, 6));
    sprites_push(&self, sprite_init(400, 400, glob.sprite_tag.nest.brown,    4));
    ret self;
}

type font_t
{
    ptr surface;
    ptr texture;
    i64 zoom;
    i64 xtiles;
    i64 ytiles;
    i64 tile_width;
    i64 tile_height;
};

font_t
font_init(sdl_t* sdl, i8* path, i64 zoom, i64 xtiles, i64 ytiles, i64 tile_width, i64 tile_height)
{
    font_t self;
    self.surface = sdl_load_bmp(path);
    self.texture = sdl_surface_to_texture(sdl, self.surface);
    self.zoom = zoom;
    self.xtiles = xtiles;
    self.ytiles = ytiles;
    self.tile_width = tile_width;
    self.tile_height = tile_height;
    ret self;
}

void
font_del(font_t* self)
{
    sdl_del_bmp(self.surface);
    sdl_destroy_texture(self.texture);
    ret;
}

sdl_rect_t
font_get_source_rect(font_t* self, i8 ch)
{
    i64 index = <i64>(ch);
    i64 x = index % self.xtiles;
    i64 y = index / self.xtiles;
    sdl_rect_t rect;
    rect.x = <i32>(x * self.tile_width);
    rect.y = <i32>(y * self.tile_height);
    rect.w = <i32>(self.tile_width);
    rect.h = <i32>(self.tile_height);
    ret rect;
}

sdl_rect_t
font_get_dest_rect(font_t* self, i64 x, i64 y)
{
    sdl_rect_t rect;
    rect.x = <i32>(x);
    rect.y = <i32>(y);
    rect.w = <i32>(self.zoom * self.tile_width);
    rect.h = <i32>(self.zoom * self.tile_height);
    ret rect;
}

void
sdl_write_font(sdl_t* sdl, font_t* self, i8* message, i64 x, i64 y)
{
    i8 ch;
    i64 i;
    i64 begin = x;
    while((ch = message[i]) != '\0')
    {
        defer i++;
        sdl_rect_t source = font_get_source_rect(self, ch);
        sdl_rect_t dest = font_get_dest_rect(self, x, y);
        if(ch == '\n')
        {
            y = y + <i64>(dest.h);
            x = begin;
        }
        else
        {
            sdl_render_copy_ex(sdl, self.texture, &source, &dest, <i32>(0));
            x = x + <i64>(dest.w);
        }
    }
    ret;
}

i32 main()
{
    glob_t glob = glob_init();
    sdl_t sdl = sdl_init(1024, 768);
    sheets_t sheets = populate_sheets(&sdl);
    sprites_t sprites = populate_sprites(&sdl, &glob);
    font_t font = font_init(&sdl, "font.bmp", 2, 16, 8, 8, 8);
    defer sdl_del(&sdl);
    defer sheets_del(&sheets);
    defer sprites_del(&sprites);
    defer font_del(&font);

    i64 cycle = 0;
    while(glob.true)
    {
        defer cycle++;
        if(sdl_is_key_down(glob.scancode.end))
        {
            puts("Thanks for playing...");
            ret <i32>(0);
        }
        sprites_move(&sprites, &sdl, &sheets, &glob);
        sprites_sort(&sprites, &sheets);
        sdl_clear_screen(&sdl);
        sprites_render(&sprites, &sdl, &sheets, &glob, cycle);
        sdl_write_font(&sdl, &font, "this is a test!!!!\nTHIS IS\'' A TEST", 0, 0);
        sdl_present(&sdl);
        sdl_delay(10);
    }

    ret <i32>(0);
}
