include "sdl.n";

type point_t
{
    i64 x;
    i64 y;
};

point_t
point_add(point_t a, point_t b)
{
    point_t self;
    self.x = a.x + b.x;
    self.y = a.y + b.y;
    ret self;
}

type sheet_t
{
    ptr surface;
    ptr texture;
    i64 tile_width;
    i64 tile_height;
};

sheet_t
sheet_init(sdl_t* sdl, i8* path, i64 tile_width, i64 tile_height)
{
    sheet_t self;
    self.surface = sdl_load_bmp(path);
    self.texture = sdl_surface_to_texture(sdl, self.surface);
    self.tile_width = tile_width;
    self.tile_height = tile_height;
    ret self;
}

void
sheet_del(sheet_t* self)
{
    sdl_del_bmp(self.surface);
    sdl_destroy_texture(self.texture);
    ret;
}

type chicken_t
{
    i64 black;
    i64 white;
    i64 brown;
};

type sprite_tag_t
{
    chicken_t chicken;
};

type sprite_state_t
{
    i64 idle;
    i64 walk;
    i64 sleep;
};

type sprite_state_cycles_t
{
    i64 idle;
    i64 walk;
    i64 sleep;
};

type scancode_t
{
    i64 end;
};

type const_t
{
    sprite_tag_t sprite_tag;
    sprite_state_t sprite_state;
    sprite_state_t sprite_state_cycles;
    scancode_t scancode;
    i1 true;
    i1 false;
    i64 sheet_frames;
    i64 sheet_states;
};

const_t
const_init()
{
    const_t self;
    self.sprite_tag.chicken.black = 0;
    self.sprite_tag.chicken.white = 1;
    self.sprite_tag.chicken.brown = 2;
    self.sprite_state.idle = 0;
    self.sprite_state.walk = 1;
    self.sprite_state.sleep = 2;
    self.sprite_state_cycles.idle = 30;
    self.sprite_state_cycles.walk = 20;
    self.sprite_state_cycles.sleep = 40;
    self.scancode.end = 77;
    self.true = 1 == 1;
    self.false = !self.true;
    self.sheet_frames = 3;
    self.sheet_states = 3;
    ret self;
}

type sheets_t
{
    sheet_t[] sheet;
    i64 size;
    i64 cap;
};

sheets_t
sheets_init()
{
    sheets_t self;
    self.cap = 32;
    self.sheet = new sheet_t[self.cap];
    ret self;
}

void
sheets_push(sheets_t* self, sheet_t sheet)
{
    assert(self.size < self.cap, "sheets was full");
    self.sheet[self.size++] = sheet;
    ret;
}

void
sheets_del(sheets_t* self)
{
    del self.sheet;
    ret;
}

type sprite_t
{
    point_t where;
    point_t velocity;
    i64 state;
    i64 frame;
    i64 tag;
    i64 zoom;
    i64 cycle;
};

sprite_t
sprite_init(i64 x, i64 y, i64 tag, i64 zoom)
{
    assert(zoom % 2 == 0, "sprite zoom must be even");
    sprite_t self;
    self.where.x = x;
    self.where.y = y;
    self.tag = tag;
    self.zoom = zoom;
    ret self;
}

type sprites_t
{
    sprite_t[] sprite;
    i64 size;
    i64 cap;
};

sprites_t
sprites_init()
{
    sprites_t self;
    self.cap = 512;
    self.sprite = new sprite_t[self.cap];
    ret self;
}

void
sprites_push(sprites_t* self, sprite_t sprite)
{
    assert(self.size < self.cap, "sprites was full");
    self.sprite[self.size++] = sprite;
    ret;
}

void
sprite_swap(sprite_t* self, sprite_t* other)
{
    sprite_t temp = *self;
    *self = *other;
    *other = temp;
    ret;
}

void
sprite_sort(sprite_t[] self, i64 lo, i64 hi)
{
    if(lo >= hi)
    {
        ret;
    }
    i64 pivot = self[hi].where.y;
    i64 i = lo;
    i64 j = lo;
    while(j < hi)
    {
        defer j++;
        if(self[j].where.y <= pivot)
        {
            sprite_swap(&self[i], &self[j]);
            i++;
        }
    }
    sprite_swap(&self[i], &self[hi]);
    sprite_sort(self, lo, i - 1);
    sprite_sort(self, i + 1, hi);
    ret;
}

void
sprites_sort(sprites_t* self)
{
    sprite_sort(self.sprite, 0, self.size - 1);
    ret;
}

void
sprites_del(sprites_t* self)
{
    del self.sprite;
    ret;
}

void
sprite_set_idle_state(sprite_t* self, const_t* const)
{
    point_t zero;
    self.velocity = zero;
    self.cycle = const.sprite_state_cycles.idle;
    ret;
}

void
sprite_set_walk_state(sprite_t* self, const_t* const)
{
    i64 shift = self.zoom / 2;
    self.velocity.x = <i64>(rand()) % (self.zoom + 1) - shift;
    self.velocity.y = <i64>(rand()) % (self.zoom + 1) - shift;
    self.cycle = const.sprite_state_cycles.walk;
    ret;
}

void
sprite_set_sleep_state(sprite_t* self, const_t* const)
{
    point_t zero;
    self.velocity = zero;
    self.cycle = const.sprite_state_cycles.sleep;
    ret;
}

sheet_t*
sprite_get_sheet(sheets_t* self, i64 tag)
{
    ret &self.sheet[tag];
}

point_t
sprite_get_true_size(sprite_t* self, sheets_t* sheets)
{
    sheet_t* sheet = sprite_get_sheet(sheets, self.tag);
    point_t point;
    point.x = self.zoom * sheet.tile_width;
    point.y = self.zoom * sheet.tile_height;
    ret point;
}

sdl_rect_t
sprite_get_source_rect(sprite_t* self, sheets_t* sheets, const_t* const)
{
    sheet_t* sheet = sprite_get_sheet(sheets, self.tag);
    i64 frame = self.frame % const.sheet_frames;
    i64 state = self.state % const.sheet_states;
    sdl_rect_t rect;
    rect.x = <i32>(sheet.tile_width * frame);
    rect.y = <i32>(sheet.tile_height * state);
    rect.w = <i32>(sheet.tile_width);
    rect.h = <i32>(sheet.tile_height);
    ret rect;
}

sdl_rect_t
sprite_get_dest_rect(sprite_t* self, sheets_t* sheets)
{
    sheet_t* sheet = sprite_get_sheet(sheets, self.tag);
    point_t size = sprite_get_true_size(self, sheets);
    sdl_rect_t rect;
    rect.x = <i32>(self.where.x);
    rect.y = <i32>(self.where.y);
    rect.w = <i32>(size.x);
    rect.h = <i32>(size.y);
    ret rect;
}

i1
sprite_is_out_of_bounds(sprite_t* self, sdl_t* sdl, sheets_t* sheets)
{
    point_t size = sprite_get_true_size(self, sheets);
    ret self.where.x > sdl.xres - size.x
      | self.where.y > sdl.yres - size.y
      | self.where.x < 0
      | self.where.y < 0;
}

void
sprite_move(sprite_t* self, sdl_t* sdl, sheets_t* sheets)
{
    point_t revert = self.where;
    self.where = point_add(self.where, self.velocity);
    if(sprite_is_out_of_bounds(self, sdl, sheets))
    {
        self.where = revert;
    }
    ret;
}

void
sprite_set_state(sprite_t* self, sheets_t* sheets, const_t* const)
{
    if(self.cycle == 0)
    {
        sheet_t* sheet = sprite_get_sheet(sheets, self.tag);
        i64 state = <i64>(rand()) % const.sheet_states;
        if(state == const.sprite_state.idle)
            sprite_set_idle_state(self, const);
        else
        if(state == const.sprite_state.walk)
            sprite_set_walk_state(self, const);
        else
        if(state == const.sprite_state.sleep)
            sprite_set_sleep_state(self, const);
        else
            abort("unknown sprite state encountered");
        self.state = state;
    }
    else
    {
        self.cycle--;
    }
    ret;
}

void
sprites_move(sprites_t* self, sdl_t* sdl, sheets_t* sheets, const_t* const)
{
    i64 i = 0;
    while(i < self.size)
    {
        defer i++;
        sprite_t* sprite = &self.sprite[i];
        sprite_set_state(sprite, sheets, const);
        sprite_move(sprite, sdl, sheets);
    }
    ret;
}

void
sprites_render(sprites_t* self, sdl_t* sdl, sheets_t* sheets, const_t* const, i64 cycle)
{
    i64 i = 0;
    while(i < self.size)
    {
        defer i++;
        sprite_t* sprite = &self.sprite[i];
        sdl_rect_t source = sprite_get_source_rect(sprite, sheets, const);
        sdl_rect_t dest = sprite_get_dest_rect(sprite, sheets);
        i32 flip;
        if(sprite.velocity.x < 0)
            flip = <i32>(0);
        else
            flip = <i32>(1);
        sdl_render_copy_ex(sdl, sheets.sheet[sprite.tag].texture, &source, &dest, flip);
        if(cycle % 10 == 0)
        {
            sprite.frame++;
        }
    }
    ret;
}

sheets_t
populate_sheets(sdl_t* sdl)
{
    sheets_t self = sheets_init();
    sheets_push(&self, sheet_init(sdl, "black_chicken.bmp", 32, 32));
    sheets_push(&self, sheet_init(sdl, "white_chicken.bmp", 32, 32));
    sheets_push(&self, sheet_init(sdl, "brown_chicken.bmp", 32, 32));
    ret self;
}

sprites_t
populate_sprites(const_t* const)
{
    sprites_t self = sprites_init();
    sprites_push(&self, sprite_init(  0,   0, const.sprite_tag.chicken.black, 6));
    sprites_push(&self, sprite_init(100, 100, const.sprite_tag.chicken.white, 6));
    sprites_push(&self, sprite_init(200, 200, const.sprite_tag.chicken.brown, 6));
    sprites_push(&self, sprite_init(300, 200, const.sprite_tag.chicken.brown, 6));
    sprites_push(&self, sprite_init(400, 200, const.sprite_tag.chicken.white, 6));
    sprites_push(&self, sprite_init(440, 280, const.sprite_tag.chicken.black, 6));
    sprites_push(&self, sprite_init(600, 270, const.sprite_tag.chicken.black, 6));
    sprites_push(&self, sprite_init(700, 270, const.sprite_tag.chicken.white, 6));
    ret self;
}

i32 main()
{
    const_t const = const_init();
    sdl_t sdl = sdl_init(1024, 768);
    sheets_t sheets = populate_sheets(&sdl);
    sprites_t sprites = populate_sprites(&const);

    defer sdl_del(&sdl);
    defer sheets_del(&sheets);
    defer sprites_del(&sprites);

    i64 cycle = 0;
    while(const.true)
    {
        defer cycle++;
        if(sdl_is_key_down(const.scancode.end))
        {
            puts("Thanks for playing...");
            ret <i32>(0);
        }
        sprites_move(&sprites, &sdl, &sheets, &const);
        sprites_sort(&sprites);
        sdl_clear_screen(&sdl);
        sprites_render(&sprites, &sdl, &sheets, &const, cycle);
        sdl_present(&sdl);
        sdl_delay(10);
    }

    ret <i32>(0);
}
