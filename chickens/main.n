include "../lib/std.n";
include "../lib/sdl.n";

type point_t
{
    i32 x;
    i32 y;
};

type sheet_t
{
    ptr surface;
    ptr texture;
    i32 tile_width;
    i32 tile_height;
    i32 frames;
    i32 states;
};

type sheets_t
{
    sheet_t* sheet;
    u64 size;
    u64 cap;
};

type tag_t
{
    i32 black_chicken = 0;
    i32 white_chicken = 1;
    i32 brown_chicken = 2;
    i32 brown_nest = 3;
    i32 wood_floor = 4;
};

type state_t
{
    i32 idle = 0;
    i32 walk = 1;
    i32 sleep = 2;
};

type cycle_t
{
    i32 idle = 30;
    i32 walk = 40;
    i32 sleep = 500;
};

type dice_t
{
    i32 idle = 20;
    i32 walk = 98;
    i32 sleep = 100;
};

type glob_t
{
    tag_t tags;
    state_t states;
    cycle_t cycles;
    dice_t dices;
    sdl_scancode_t scancode;
    i32 percent_cap = 100;
    i32 cycles_per_frame = 5;
};

type sprite_t
{
    sheet_t* sheet;
    point_t where;
    point_t velocity;
    i32 state;
    i32 frame;
    i32 tag;
    i32 zoom;
    i32 cycle;
    i1 is_facing_right;
    i1 is_bottom_sort;
    i8* message;
};

type sprites_t
{
    sprite_t* sprite;
    u64 size;
    u64 cap;
};

sheet_t
sheet_init(sdl_t* sdl, i8* path, i32 tile_width, i32 tile_height, i32 frames, i32 states)
{
    sheet_t self;
    self.surface = sdl_load_bmp(path);
    self.texture = sdl_surface_to_texture(sdl, self.surface);
    self.tile_width = tile_width;
    self.tile_height = tile_height;
    self.frames = frames;
    self.states = states;
    ret self;
}

void
sheet_del(sheet_t* self)
{
    sdl_del_bmp(self.surface);
    sdl_destroy_texture(self.texture);
    ret;
}

glob_t
glob_init()
{
    glob_t self;
    ret self;
}

sheets_t
sheets_init()
{
    sheets_t self;
    self.cap = u64 32;
    self.sheet = new sheet_t[self.cap];
    ret self;
}

void
sheets_push(sheets_t* self, sheet_t sheet)
{
    if(self.size >= self.cap)
    {
        printf("too many sheets!\n");
        exit(1);
    }
    self.sheet[self.size++] = sheet;
    ret;
}

void
sheets_del(sheets_t* self)
{
    del self.sheet;
    ret;
}

i1
is_chicken(sprite_t* self, tag_t* tags)
{
    ret self.tag == tags.black_chicken
      | self.tag == tags.white_chicken
      | self.tag == tags.brown_chicken;
}

i1
is_nest(sprite_t* self, tag_t* tags)
{
    ret self.tag == tags.brown_nest;
}

i1
is_bottom_sort(sprite_t* self, tag_t* tags)
{
    ret is_chicken(self, tags);
}

sprite_t
sprite_init(i32 x, i32 y, sheets_t* sheets, i32 tag, i32 zoom, tag_t* tags)
{
    sprite_t self;
    self.sheet = &sheets.sheet[u64 tag];
    self.where.x = x;
    self.where.y = y;
    self.tag = tag;
    self.zoom = zoom;
    self.is_bottom_sort = is_bottom_sort(&self, tags);
    ret self;
}

point_t
sprite_get_true_size(sprite_t* self)
{
    point_t point;
    point.x = self.zoom * self.sheet.tile_width;
    point.y = self.zoom * self.sheet.tile_height;
    ret point;
}

sdl_rect_t
sprite_get_dest_rect(sprite_t* self)
{
    point_t size = sprite_get_true_size(self);
    sdl_rect_t rect;
    rect.x = self.where.x;
    rect.y = self.where.y;
    rect.w = size.x;
    rect.h = size.y;
    ret rect;
}

i32
sprite_get_foot(sprite_t* self)
{
    sdl_rect_t rect = sprite_get_dest_rect(self);
    if(self.is_bottom_sort)
    {
        ret rect.y + rect.h;
    }
    ret rect.y;
}

i32
sprite_compare_feet(sprite_t* left, sprite_t* rite)
{
    ret i32 (sprite_get_foot(left) > sprite_get_foot(rite));
}

void
sprite_set_idle_state(sprite_t* self, glob_t* glob)
{
    point_t zero;
    self.velocity = zero;
    self.cycle = glob.cycles.idle;
    self.state = glob.states.idle;
    ret;
}

void
sprite_set_walk_state(sprite_t* self, glob_t* glob)
{
    i32 shift = self.zoom / 2;
    self.velocity.x = rand() % (self.zoom + 1) - shift;
    self.velocity.y = rand() % (self.zoom + 1) - shift;
    point_t zero;
    if(self.velocity.x == 0 & self.velocity.y == 0)
    {
        sprite_set_walk_state(self, glob); // Reroll
    }
    else
    {
        self.cycle = glob.cycles.walk;
        self.state = glob.states.walk;
    }
    ret;
}

void
sprite_set_sleep_state(sprite_t* self, glob_t* glob)
{
    point_t zero;
    self.velocity = zero;
    self.cycle = glob.cycles.sleep;
    self.state = glob.states.sleep;
    ret;
}

sdl_rect_t
sprite_get_source_rect(sprite_t* self, glob_t* glob)
{
    i32 frame = self.frame % self.sheet.frames;
    i32 state = self.state % self.sheet.states;
    sdl_rect_t rect;
    rect.x = self.sheet.tile_width * frame;
    rect.y = self.sheet.tile_height * state;
    rect.w = self.sheet.tile_width;
    rect.h = self.sheet.tile_height;
    ret rect;
}

i1
sprite_is_out_of_bounds(sprite_t* self, sdl_t* sdl)
{
    point_t size = sprite_get_true_size(self);
    ret self.where.x > sdl.xres - size.x
      | self.where.y > sdl.yres - size.y
      | self.where.x < 0
      | self.where.y < 0;
}

i1
sprite_can_walk(sprite_t* self, glob_t* glob)
{
    ret self.sheet.states > glob.states.walk;
}

void
sprite_move(sprite_t* self, sdl_t* sdl, glob_t* glob)
{
    if(sprite_can_walk(self, glob))
    {
        point_t revert = self.where;
        self.where = self.where + self.velocity;
        if(sprite_is_out_of_bounds(self, sdl))
        {
            self.where = revert;
            sprite_set_idle_state(self, glob);
        }
        if(self.state == glob.states.walk)
        {
            self.is_facing_right = self.velocity.x > 0;
        }
    }
    ret;
}

i32
sprite_roll_state(sprite_t* self, glob_t* glob)
{
    i32 roll = rand() % glob.percent_cap;
    if(roll < glob.dices.idle ) ret glob.states.idle;
    if(roll < glob.dices.walk ) ret glob.states.walk;
    if(roll < glob.dices.sleep) ret glob.states.sleep;
    ret glob.states.idle;
}

void
sprite_set_state(sprite_t* self, glob_t* glob)
{
    if(self.cycle == 0)
    {
        i32 state = sprite_roll_state(self, glob);
        if(state == glob.states.idle)
            sprite_set_idle_state(self, glob);
        else
        if(state == glob.states.walk)
            sprite_set_walk_state(self, glob);
        else
        if(state == glob.states.sleep)
            sprite_set_sleep_state(self, glob);
        else
        {
            printf("unknown sprite state encountered\n");
            exit(1);
        }
    }
    else
    {
        self.cycle--;
    }
    ret;
}

i1
sprite_is_close(sprite_t* self, sprite_t* other)
{
    if(self == other)
    {
        ret i1 0;
    }
    i32 by = 32;
    point_t delta = self.where - other.where;
    delta.x = abs(delta.x);
    delta.y = abs(delta.y);
    ret delta.x < by & delta.y < by;
}

void
sprite_bawk(sprite_t* self, sprite_t* other, glob_t* glob)
{
    if(self.state != glob.states.sleep)
    {
        if(is_chicken(other, &glob.tags))
        {
            if(other.state == glob.states.sleep)
            {
                self.message = "bawk...";
            }
            if(self.is_facing_right & !other.is_facing_right)
            {
                self.message = "bawk!";
            }
            if(!self.is_facing_right & other.is_facing_right)
            {
                self.message = "bawk!";
            }
        }
        if(is_nest(other, &glob.tags))
        {
            self.message = "bawk?";
            other.message = "rustle";
        }
    }
    ret;
}

sprite_t*
sprite_interact(sprite_t* self, sprites_t* sprites, i1() condition)
{
    u64 i;
    while(i < sprites.size)
    {
        sprite_t* other = &sprites.sprite[i];
        if(condition(self, other))
        {
            ret other;
        }
        i++;
    }
    ret sprite_t* 0;
}

sprites_t
sprites_init()
{
    sprites_t self;
    self.cap = u64 16;
    self.sprite = new sprite_t[self.cap];
    ret self;
}

void
sprites_push(sprites_t* self, sprite_t sprite)
{
    if(self.size >= self.cap)
    {
        printf("too many sprites!\n");
        exit(1);
    }
    self.sprite[self.size++] = sprite;
    ret;
}

void
sprites_sort(sprites_t* self)
{
    qsort(ptr self.sprite, u64 self.size, sizeof *self.sprite, sprite_compare_feet);
    ret;
}

void
sprites_del(sprites_t* self)
{
    del self.sprite;
    ret;
}

void
sprites_bawk(sprites_t* self, sdl_t* sdl, glob_t* glob)
{
    u64 i;
    while(i < self.size)
    {
        sprite_t* sprite = &self.sprite[i];
        sprite_t* other = sprite_interact(sprite, self, sprite_is_close);
        if(other != sprite_t* 0)
        {
            sprite_bawk(sprite, other, glob);
        }
        i++;
    }
    ret;
}

void
sprites_reset(sprites_t* self, glob_t* glob)
{
    u64 i;
    while(i < self.size)
    {
        sprite_t* sprite = &self.sprite[i];
        sprite.message = "";
        i++;
    }
    ret;
}

void
sprites_move(sprites_t* self, sdl_t* sdl, glob_t* glob)
{
    u64 i;
    while(i < self.size)
    {
        sprite_t* sprite = &self.sprite[i];
        sprite_set_state(sprite, glob);
        sprite_move(sprite, sdl, glob);
        i++;
    }
    ret;
}

void
sprites_render(sprites_t* self, sdl_t* sdl, sdl_font_t* font, glob_t* glob, i32 cycle)
{
    u64 i;
    while(i < self.size)
    {
        sprite_t* sprite = &self.sprite[i];
        sdl_rect_t source = sprite_get_source_rect(sprite, glob);
        sdl_rect_t dest = sprite_get_dest_rect(sprite);
        i32 flip;
        if(sprite.is_facing_right)
            flip = 1;
        else
            flip = 0;
        sdl_render_copy_ex(sdl, sprite.sheet.texture, &source, &dest, flip);
        sdl_write_font(sdl, font, sprite.message, dest.x, dest.y);
        if(cycle % glob.cycles_per_frame == 0)
        {
            sprite.frame++;
        }
        i++;
    }
    ret;
}

void
render_floor(sdl_t* sdl, sheets_t* sheets, glob_t* glob)
{
    sheet_t* sheet = &sheets.sheet[u64 glob.tags.wood_floor];
    i32 zoom = 2;
    i32 w = zoom * sheet.tile_width;
    i32 h = zoom * sheet.tile_height;
    i32 xtiles = sdl.xres / w + 1;
    i32 ytiles = sdl.yres / h + 1;
    sdl_rect_t source;
    source.x = 0;
    source.y = 0;
    source.w = sheet.tile_width;
    source.h = sheet.tile_height;
    i32 y;
    while(y < ytiles)
    {
        i32 x;
        while(x < xtiles)
        {
            sdl_rect_t dest;
            dest.x = x * w;
            dest.y = y * h;
            dest.w = w;
            dest.h = h;
            sdl_render_copy_ex(sdl, sheet.texture, &source, &dest, 0);
            x++;
        }
        y++;
    }
    ret;
}

sheets_t
populate_sheets(sdl_t* sdl)
{
    sheets_t self = sheets_init();
    sheets_push(&self, sheet_init(sdl, "black_chicken.bmp", 32, 32, 3, 3));
    sheets_push(&self, sheet_init(sdl, "white_chicken.bmp", 32, 32, 3, 3));
    sheets_push(&self, sheet_init(sdl, "brown_chicken.bmp", 32, 32, 3, 3));
    sheets_push(&self, sheet_init(sdl, "brown_nest.bmp",    32, 32, 2, 1));
    sheets_push(&self, sheet_init(sdl, "wood_floor.bmp",    32, 32, 1, 1));
    ret self;
}

sprites_t
populate_sprites(sdl_t* sdl, glob_t* glob, sheets_t* sheets)
{
    sprites_t self = sprites_init();
    u64 i;
    while(i < self.cap)
    {
        i32 tag = rand() % glob.tags.wood_floor;
        sprite_t sprite = sprite_init(0, 0, sheets, tag, 2, &glob.tags);
        point_t size = sprite_get_true_size(&sprite);
        sprite.where.x = rand() % (sdl.xres - size.x);
        sprite.where.y = rand() % (sdl.yres - size.y);
        sprites_push(&self, sprite);
        i++;
    }
    ret self;
}

i32
main(i32 argc, i8** argv)
{
    if(argc != 5)
    {
        printf("required args: x y xres yres\n");
        exit(1);
    }
    glob_t glob = glob_init();
    sdl_t sdl = sdl_init(
        atoi(argv[u64 1]),
        atoi(argv[u64 2]),
        atoi(argv[u64 3]),
        atoi(argv[u64 4]),
        "chickens");
    sheets_t sheets = populate_sheets(&sdl);
    sprites_t sprites = populate_sprites(&sdl, &glob, &sheets);
    sdl_font_t font = sdl_font_init(&sdl, "../lib/font.bmp", 2, 16, 8, 8, 8);
    sdl_average_t fps = sdl_average_init(u64 8);
    f64 dt;
    i32 cycle;
    while(i1 1)
    {
        f64 t0 = sdl_get_seconds();
        if(sdl_is_done())
        {
            break;
        }
        sprites_reset(&sprites, &glob);
        sprites_move(&sprites, &sdl, &glob);
        sprites_bawk(&sprites, &sdl, &glob);
        sprites_sort(&sprites);
        sdl_clear_screen(&sdl);
        render_floor(&sdl, &sheets, &glob);
        sprites_render(&sprites, &sdl, &font, &glob, cycle);
        sdl_write_font(&sdl, &font, sdl.name, sdl.margin, sdl.margin);
        sdl_write_fps(&sdl, &font, &fps);
        sdl_present(&sdl);
        f64 t1 = sdl_get_seconds();
        dt = t1 - t0;
        if(dt > 0.0)
        {
            sdl_average_push(&fps, 1.0 / dt);
        }
        cycle++;
    }
    sdl_font_del(&font);
    sdl_del(&sdl);
    sheets_del(&sheets);
    sprites_del(&sprites);
    sdl_average_del(&fps);
    ret 0;
}
