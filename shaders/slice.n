type slice_t
{
    sdl_t* sdl;
    sdl_stream_t* stream;
    sdl_vec4() shader;
    i32 x0;
    i32 x1;
};

void
slice_draw(slice_t* slice)
{
    i32 y;
    while(y < slice.sdl.yres)
    {
        i32 x = slice.x0;
        while(x < slice.x1)
        {
            sdl_vec2 resolution;
            resolution.x = double slice.sdl.xres;
            resolution.y = double slice.sdl.yres;
            sdl_vec2 coord;
            coord.x = double x;
            coord.y = double y;
            double seconds = sdl_get_seconds();
            sdl_vec4 pixel = slice.shader(resolution, coord, seconds);
            sdl_stream_put(slice.stream, slice.sdl, x, y, pixel);
            x++;
        }
        y++;
    }
    ret;
}

ptr
slice_run(ptr with)
{
    slice_t* slice = slice_t* with;
    slice_draw(slice);
    ret ptr 0;
}

slice_t*
slice_setup_cores(sdl_t* sdl, sdl_stream_t* stream, sdl_vec4() shader, i32 cores)
{
    i32 width = sdl.xres / cores;
    i32 x = 0;
    slice_t* slices = new slice_t[u64 cores];
    i32 core;
    while(core < cores)
    {
        slice_t slice;
        slice.sdl = sdl;
        slice.stream = stream;
        slice.shader = shader;
        slice.x0 = x;
        slice.x1 = slice.x0 + width;
        slices[u64 core] = slice;
        x = slice.x1;
        core++;
    }
    ret slices;
}

void
slice_run_cores(slice_t* slices, i32 cores)
{
    u64* threads = new u64[u64 cores];
    defer del threads;
    i32 i;
    while(i < cores)
    {
        pthread_create(&threads[u64 i], ptr 0, slice_run, ptr &slices[u64 i]);
        i++;
    }
    i32 j;
    while(j < cores)
    {
        pthread_join(threads[u64 j], ptr* 0);
        j++;
    }
    ret;
}
