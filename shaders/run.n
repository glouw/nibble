void
run(i32 argc, i8** argv, sdl_vec4() shader, i8* name)
{
    sdl_t sdl = sdl_demo_init(argc, argv, name);
    sdl_scancode_t scancode;
    sdl_font_t font = sdl_font_init(&sdl, "../lib/font.bmp", 2, 16, 8, 8, 8);
    sdl_stream_t stream = sdl_stream_init(&sdl);
    sdl_average_t average = sdl_average_init(u64 30);
    i32 cycle;
    f64 dt;
    while(i1 1)
    {
        f64 t0 = sdl_get_seconds();
        if(sdl_is_done())
        {
            ret;
        }
        sdl_clear_screen(&sdl);
        sdl_lock_stream(&stream);
        i32 cores = sdl_get_cpu_count();
        slice_t* slices = slice_setup_cores(&sdl, &stream, shader, cores);
        defer del slices;
        slice_run_cores(slices, cores);
        sdl_send_stream(&stream, &sdl);
        sdl_write_font(&sdl, &font, sdl.name, sdl.margin, sdl.margin);
        sdl_write_fps(&sdl, &font, &average);
        sdl_present(&sdl);
        f64 t1 = sdl_get_seconds();
        dt = t1 - t0;
        if(dt > 0.0)
        {
            sdl_average_push(&average, 1.0 / dt);
        }
        cycle++;
    }
    sdl_del(&sdl);
    sdl_stream_del(&stream);
    sdl_font_del(&font);
    sdl_average_del(&average);
    ret;
}
