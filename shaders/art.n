include "../lib/std.n";
include "../lib/sdl.n";
include "../lib/pthread.n";

include "slice.n";

sdl_vec3 palette(double t)
{
    sdl_vec3 a = sdl_vec3_init(0.5, 0.5, 0.5);
    sdl_vec3 b = sdl_vec3_init(0.5, 0.5, 0.5);
    sdl_vec3 c = sdl_vec3_init(1.0, 1.0, 1.0);
    sdl_vec3 d = sdl_vec3_init(0.263, 0.416, 0.557);
    sdl_vec3 t_ident = sdl_vec3_init(t, t, t);
    double two_pi = 2.0 * 3.14159265359;
    sdl_vec3 two_pi_ident = sdl_vec3_init(two_pi, two_pi, two_pi);
    sdl_vec3 freq = c * t_ident + d;
    sdl_vec3 amplitude = sdl_cos3(two_pi_ident * freq);
    ret a + b * amplitude;
}

sdl_vec4
art(sdl_vec2 resolution, sdl_vec2 coord, double seconds)
{
    sdl_vec2 uv = sdl_mul2s(coord, 2.0);
    uv = uv - resolution;
    uv = sdl_div2s(uv, resolution.y);
    sdl_vec2 uv0 = uv;
    sdl_vec3 color;
    double i;
    while(i < 4.0)
    {
        uv = sdl_sub2s(sdl_fract2(sdl_mul2s(uv, 1.5)), 0.5);
        double d = sdl_len2(uv) * exp(-sdl_len2(uv0));
        sdl_vec3 col = palette(sdl_len2(uv0) + 0.4 * (i + seconds));
        d = sin(8.0 * d + seconds) / 8.0;
        d = fabs(d);
        d = pow(0.01 / d, 1.2);
        sdl_vec3 step = sdl_mul3s(col, d);
        color = color + step;
        i++;
    }
    sdl_vec4 out;
    out.r = color.x;
    out.g = color.y;
    out.b = color.z;
    out.a = 1.0;
    ret out;
}

i32
main()
{
    run(art, "shader art coding introduction\nby kishimisu");
    ret <i32>(0);
}
