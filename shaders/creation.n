include "../lib/std.n";
include "../lib/sdl.n";
include "../lib/pthread.n";
include "slice.n";
include "run.n";

sdl_vec4
creation(sdl_vec2 res, sdl_vec2 coord, double secs)
{
    sdl_vec2 distance;
    sdl_vec3 color;
    double time = secs;
    double step = 0.07;
    double frequency = 9.0;
    i64 slots = 3;
    i64 slot;
    while(slot < slots)
    {
        sdl_vec2 ratio = coord / res;
        sdl_vec2 uv = ratio;
        sdl_vec2 shift;
        shift.x = shift.y = 0.5;
        ratio = ratio - shift;
        ratio.x = ratio.x * res.x / res.y;
        distance.x = distance.y = sdl_len2(ratio);
        sdl_vec2 envelope;
        envelope.x = envelope.y = sin(time) + 1.0;
        sdl_vec2 wave;
        wave.x = wave.y = fabs(sin(distance.x * frequency - 2.0 * time));
        sdl_vec2 sample = sdl_mod2s(uv + ratio / distance * envelope * wave, 1.0);
        double out = 0.01 / sdl_len2(sample - shift);
        if(slot == 0) color.x = out;
        if(slot == 1) color.y = out;
        if(slot == 2) color.z = out;
        time = time + step;
        slot++;
    }
    sdl_vec4 out;
    out.r = color.x / distance.x;
    out.g = color.y / distance.x;
    out.b = color.z / distance.x;
    out.a = secs;
    ret out;
}

i32
main(i32 argc, i8** argv)
{
    run(argc, argv, creation, "creation\nby danilo guanabara");
    ret <i32>(0);
}
