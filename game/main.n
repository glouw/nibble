include "../lib/std.n";
include "../lib/sdl.n";

type point_t
{
    i64 x;
    i64 y;
};

type sheet_t
{
    ptr surface;
    ptr texture;
    i64 tile_width;
    i64 tile_height;
    i64 frames;
    i64 states;
};

sheet_t
sheet_init(sdl_t* sdl, i8* path, i64 tile_width, i64 tile_height, i64 frames, i64 states)
{
    sheet_t self;
    self.surface = sdl_load_bmp(path);
    self.texture = sdl_surface_to_texture(sdl, self.surface);
    self.tile_width = tile_width;
    self.tile_height = tile_height;
    self.frames = frames;
    self.states = states;
    ret self;
}

void
sheet_del(sheet_t* self)
{
    sdl_del_bmp(self.surface);
    sdl_destroy_texture(self.texture);
    ret;
}

type chicken_t
{
    i64 black = 0;
    i64 white = 1;
    i64 brown = 2;
};

type nest_t
{
    i64 brown = 3;
};

type sprite_tag_t
{
    chicken_t chicken;
    nest_t nest;
};

type sprite_state_t
{
    i64 idle = 0;
    i64 walk = 1;
    i64 sleep = 2;
};

type sprite_cycles_t
{
    i64 idle = 30;
    i64 walk = 40;
    i64 sleep = 500;
};

type sprite_dice_t
{
    i64 idle = 20;
    i64 walk = 98;
    i64 sleep = 100;
};

type glob_t
{
    sprite_tag_t sprite_tag;
    sprite_state_t sprite_state;
    sprite_cycles_t sprite_cycles;
    sprite_dice_t sprite_dice;
    sdl_scancode_t scancode;
    i64 percent_cap = 100;
    i64 cycles_per_frame = 5;
};

glob_t
glob_init()
{
    glob_t self;
    ret self;
}

type sheets_t
{
    sheet_t* sheet;
    i64 size;
    i64 cap;
};

sheets_t
sheets_init()
{
    sheets_t self;
    self.cap = 32;
    self.sheet = new sheet_t[self.cap];
    ret self;
}

void
sheets_push(sheets_t* self, sheet_t sheet)
{
    assert(self.size < self.cap, "sheets was full");
    self.sheet[self.size++] = sheet;
    ret;
}

void
sheets_del(sheets_t* self)
{
    del self.sheet;
    ret;
}

type sprite_t
{
    sheet_t* sheet;
    point_t where;
    point_t velocity;
    i64 state;
    i64 frame;
    i64 tag;
    i64 zoom;
    i64 cycle;
    i1 is_facing_right;
};

sprite_t
sprite_init(i64 x, i64 y, sheets_t* sheets, i64 tag, i64 zoom)
{
    assert(zoom % 2 == 0, "sprite zoom must be even");
    sprite_t self;
    self.sheet = &sheets.sheet[tag];
    self.where.x = x;
    self.where.y = y;
    self.tag = tag;
    self.zoom = zoom;
    ret self;
}

type sprites_t
{
    sprite_t* sprite;
    i64 size;
    i64 cap;
};

sprites_t
sprites_init()
{
    sprites_t self;
    self.cap = 512;
    self.sprite = new sprite_t[self.cap];
    ret self;
}

void
sprites_push(sprites_t* self, sprite_t sprite)
{
    assert(self.size < self.cap, "sprites was full");
    self.sprite[self.size++] = sprite;
    ret;
}

point_t
sprite_get_true_size(sprite_t* self)
{
    point_t point;
    point.x = self.zoom * self.sheet.tile_width;
    point.y = self.zoom * self.sheet.tile_height;
    ret point;
}

sdl_rect_t
sprite_get_dest_rect(sprite_t* self)
{
    point_t size = sprite_get_true_size(self);
    sdl_rect_t rect;
    rect.x = <i32>(self.where.x);
    rect.y = <i32>(self.where.y);
    rect.w = <i32>(size.x);
    rect.h = <i32>(size.y);
    ret rect;
}

i64
sprite_get_foot(sprite_t* self)
{
    sdl_rect_t rect = sprite_get_dest_rect(self);
    ret <i64>(rect.y + rect.h);
}

i32
sprite_compare_feet(sprite_t* left, sprite_t* rite)
{
    ret <i32>(sprite_get_foot(left) > sprite_get_foot(rite));
}

void
sprites_sort(sprites_t* self)
{
    qsort(<ptr>(self.sprite), <u64>(self.size), sizeof self.sprite[0], sprite_compare_feet);
    ret;
}

void
sprites_del(sprites_t* self)
{
    del self.sprite;
    ret;
}

void
sprite_set_idle_state(sprite_t* self, glob_t* glob)
{
    point_t zero;
    self.velocity = zero;
    self.cycle = glob.sprite_cycles.idle;
    ret;
}

void
sprite_set_walk_state(sprite_t* self, glob_t* glob)
{
    i64 shift = self.zoom / 2;
    self.velocity.x = <i64>(rand()) % (self.zoom + 1) - shift;
    self.velocity.y = <i64>(rand()) % (self.zoom + 1) - shift;
    self.cycle = glob.sprite_cycles.walk;
    ret;
}

void
sprite_set_sleep_state(sprite_t* self, glob_t* glob)
{
    point_t zero;
    self.velocity = zero;
    self.cycle = glob.sprite_cycles.sleep;
    ret;
}

sdl_rect_t
sprite_get_source_rect(sprite_t* self, glob_t* glob)
{
    i64 frame = self.frame % self.sheet.frames;
    i64 state = self.state % self.sheet.states;
    sdl_rect_t rect;
    rect.x = <i32>(self.sheet.tile_width * frame);
    rect.y = <i32>(self.sheet.tile_height * state);
    rect.w = <i32>(self.sheet.tile_width);
    rect.h = <i32>(self.sheet.tile_height);
    ret rect;
}

i1
sprite_is_out_of_bounds(sprite_t* self, sdl_t* sdl)
{
    point_t size = sprite_get_true_size(self);
    ret self.where.x > sdl.xres - size.x
      | self.where.y > sdl.yres - size.y
      | self.where.x < 0
      | self.where.y < 0;
}

i1
sprite_can_walk(sprite_t* self, glob_t* glob)
{
    ret self.sheet.states > glob.sprite_state.walk;
}

void
sprite_move(sprite_t* self, sdl_t* sdl, glob_t* glob)
{
    if(sprite_can_walk(self, glob))
    {
        point_t revert = self.where;
        self.where = self.where + self.velocity;
        if(sprite_is_out_of_bounds(self, sdl))
        {
            self.where = revert;
        }
        if(self.state == glob.sprite_state.walk)
        {
            self.is_facing_right = self.velocity.x > 0;
        }
    }
    ret;
}

i64
sprite_roll_state(sprite_t* self, glob_t* glob)
{
    i64 roll = <i64>(rand()) % glob.percent_cap;
    if(roll < glob.sprite_dice.idle ) ret glob.sprite_state.idle;
    if(roll < glob.sprite_dice.walk ) ret glob.sprite_state.walk;
    if(roll < glob.sprite_dice.sleep) ret glob.sprite_state.sleep;
    ret glob.sprite_state.idle;
}

void
sprite_set_state(sprite_t* self, glob_t* glob)
{
    if(self.cycle == 0)
    {
        i64 state = sprite_roll_state(self, glob);
        if(state == glob.sprite_state.idle)
            sprite_set_idle_state(self, glob);
        else
        if(state == glob.sprite_state.walk)
            sprite_set_walk_state(self, glob);
        else
        if(state == glob.sprite_state.sleep)
            sprite_set_sleep_state(self, glob);
        else
            abort("unknown sprite state encountered");
        self.state = state;
    }
    else
    {
        self.cycle--;
    }
    ret;
}

void
sprites_move(sprites_t* self, sdl_t* sdl, glob_t* glob)
{
    i64 i = 0;
    sprite_t* sprite;
    while(i < self.size)
    {
        sprite = &self.sprite[i];
        sprite_set_state(sprite, glob);
        sprite_move(sprite, sdl, glob);
        i++;
    }
    ret;
}

void
sprites_render(sprites_t* self, sdl_t* sdl, glob_t* glob, i64 cycle)
{
    i64 i = 0;
    sprite_t* sprite;
    sdl_rect_t source;
    sdl_rect_t dest;
    i32 flip;
    while(i < self.size)
    {
        sprite = &self.sprite[i];
        source = sprite_get_source_rect(sprite, glob);
        dest = sprite_get_dest_rect(sprite);
        if(sprite.is_facing_right)
        {
            flip = <i32>(1);
        }
        else
        {
            flip = <i32>(0);
        }
        sdl_render_copy_ex(sdl, sprite.sheet.texture, &source, &dest, flip);
        if(cycle % glob.cycles_per_frame == 0)
        {
            sprite.frame++;
        }
        i++;
    }
    ret;
}

sheets_t
populate_sheets(sdl_t* sdl)
{
    sheets_t self = sheets_init();
    sheets_push(&self, sheet_init(sdl, "black_chicken.bmp", 32, 32, 3, 3));
    sheets_push(&self, sheet_init(sdl, "white_chicken.bmp", 32, 32, 3, 3));
    sheets_push(&self, sheet_init(sdl, "brown_chicken.bmp", 32, 32, 3, 3));
    sheets_push(&self, sheet_init(sdl, "brown_nest.bmp",    32, 32, 2, 1));
    ret self;
}

sprites_t
populate_sprites(sdl_t* sdl, glob_t* glob, sheets_t* sheets)
{
    sprites_t self = sprites_init();
    sprites_push(&self, sprite_init(  0,   0, sheets, glob.sprite_tag.chicken.black, 4));
    sprites_push(&self, sprite_init(100, 100, sheets, glob.sprite_tag.chicken.white, 8));
    sprites_push(&self, sprite_init(200, 200, sheets, glob.sprite_tag.chicken.brown, 4));
    sprites_push(&self, sprite_init(300, 200, sheets, glob.sprite_tag.chicken.brown, 6));
    sprites_push(&self, sprite_init(400, 200, sheets, glob.sprite_tag.chicken.white, 4));
    sprites_push(&self, sprite_init(440, 280, sheets, glob.sprite_tag.chicken.black, 6));
    sprites_push(&self, sprite_init(600, 270, sheets, glob.sprite_tag.chicken.black, 4));
    sprites_push(&self, sprite_init(700, 270, sheets, glob.sprite_tag.chicken.white, 6));
    sprites_push(&self, sprite_init(400, 400, sheets, glob.sprite_tag.nest.brown,    4));
    ret self;
}

i32
main()
{
    glob_t glob = glob_init();
    sdl_t sdl = sdl_init(1024, 768, "chickens?");
    sheets_t sheets = populate_sheets(&sdl);
    sprites_t sprites = populate_sprites(&sdl, &glob, &sheets);
    sdl_font_t font = sdl_font_init(&sdl, "../lib/font.bmp", 2, 16, 8, 8, 8);
    sdl_average_t fps = sdl_average_init(8);
    double dt;
    i64 cycle;
    while(<i1>(1))
    {
        double t0 = sdl_get_seconds();
        if(sdl_is_done())
        {
            break;
        }
        sprites_move(&sprites, &sdl, &glob);
        sprites_sort(&sprites);
        sdl_clear_screen(&sdl);
        sprites_render(&sprites, &sdl, &glob, cycle);
        sdl_scroll_t scroll = sdl_scroll_init(&sdl);
        sdl_scroll_write(&scroll, &sdl, &font, "bawk?");
        sdl_scroll_write(&scroll, &sdl, &font, "bawk!?\nanother bawk!");
        sdl_scroll_write(&scroll, &sdl, &font, "bbbbbbawk!");
        sdl_write_fps(&sdl, &font, &fps);
        sdl_present(&sdl);
        double t1 = sdl_get_seconds();
        dt = t1 - t0;
        if(dt > 0.0)
        {
            sdl_average_push(&fps, 1.0 / dt);
        }
        cycle++;
    }
    sdl_del(&sdl);
    sheets_del(&sheets);
    sprites_del(&sprites);
    sdl_font_del(&font);
    sdl_average_del(&fps);
    ret <i32>(0);
}
