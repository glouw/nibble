include "../lib/std.n";
include "../lib/sdl.n";

void
draw(sdl_t* self, tree_node_t* node, i1* done, i32 x, i32 y, i32 width, i32 height)
{
    if(node != tree_node_t* 0)
    {
        if(sdl_is_done())
        {
            *done = i1 1;
        }
        i32 half = width / 2;
        i32 xa = x - half;
        i32 xb = x + half;
        i32 ya = y + height;
        u8 red;
        u8 green;
        if(node_is_red(node))
            red = u8 255;
        else
            green = u8 255;
        sdl_set_render_draw_color(self, red, green, u8 0, u8 0);
        sdl_render_draw_line(self, x, y, xa, ya);
        sdl_render_draw_line(self, x, y, xb, ya);
        draw(self, node.l, done, xa, ya, half, height);
        draw(self, node.r, done, xb, ya, half, height);
    }
    ret;
}

void
render(sdl_t* self, sdl_font_t* font, tree_t* tree, i1* done)
{
    sdl_clear_screen(self);
    i32 border = 32;
    i32 x = self.xres / 2;
    i32 y = self.yres / 5;
    i32 w = self.xres / 2 - border;
    i32 h = 32;
    draw(self, tree.root, done, x, y, w, h);
    sdl_write_font(self, font, self.name, self.margin, self.margin);
    sdl_present(self);
    ret;
}

i32
compare(i32* x, i32* y)
{
    ret *x - *y;
}

void
delete(i32* self)
{
    ret;
}

i32* new_int(i32 value)
{
    i32* self = new i32;
    *self = value;
    ret self;
}

i32
main(i32 argc, i8** argv)
{
    if(argc != 5)
    {
        printf("required args: x y xres yres\n");
        exit(1);
    }
    sdl_t sdl = sdl_init(
        atoi(argv[u64 1]),
        atoi(argv[u64 2]),
        atoi(argv[u64 3]),
        atoi(argv[u64 4]),
        "tree");
    sdl_font_t font = sdl_font_init(&sdl, "../lib/font.bmp", 2, 16, 8, 8, 8);
    tree_t tree = tree_init(compare, delete);
    tree.verify = i1 1; // This demo is also a good stability test for rb-tree
    i1 done = i1 0;
    i32 size = 512;
    while(!done)
    {
        i32 i;
        while(i < size)
        {
            tree_insert(&tree, ptr new_int(rand()));
            render(&sdl, &font, &tree, &done);
            i++;
            if(done)
            {
                break;
            }
        }
        while(tree.size > u64 0)
        {
            tree_remove(&tree, tree.root.key);
            render(&sdl, &font, &tree, &done);
            if(done)
            {
                break;
            }
        }
    }
    sdl_font_del(&font);
    sdl_del(&sdl);
    tree_del(&tree);
    ret 0;
}
