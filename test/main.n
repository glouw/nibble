    ret test_recursion(x - 1);
}

void set_to_zero(i64* x)
{
    *x = 0;
    ret;
}

void dont_set_to_zero(i64 x)
{
    x = 42;
    ret;
}

i64 test_pointer_arg_0()
{
    i64 x;
    x = 42;
    set_to_zero(&x);
    ret x;
}

i64 test_pointer_arg_1()
{
    i64 x;
    x = 0;
    dont_set_to_zero(x);
    ret x;
}

i64 test_chain()
{
    i64 x;
    i64 y;
    i64 z;

    x = y = z = 42;

    if(x == 42 & y == 42 & z == 42)
    {
        ret 0;
    }
    ret 1;
}

i64 test_pointer_chain()
{
    i64 x;
    i64 y;
    i64 z;

    i64* px;
    i64* py;
    i64* pz;

    px = &x;
    py = &y;
    pz = &z;

    *px = *py = *pz = 42;

    if(x == 42 & y == 42 & z == 42)
    {
        ret 0;
    }
    ret 1;
}

i64 test_bitwise()
{
    i64 x;
    x = 1 & 2 & 3 & 4;

    i64 y;
    y = 1 | 2 | 3 | 4;

    i64 z;
    z = 1 ^ 2 ^ 3 ^ 4;

    i64 a;
    a = ~255;

    if(x == 0 & y == 7 & z == 4 & a == -256)
    {
        ret 0;
    }
    ret 1;
}

i64 test_shift()
{
    i64 x;
    x = 1 << 8;

    i64 y;
    y = 8;
    y = y >> 1;

    i64 z;
    z = -8;
    z = z >> 1;

    i64 a;
    a = -8;
    a = a << 1;

    if(x == 256 & y == 4 & z == -4 & a == -16)
    {
        ret 0;
    }
    ret 1;
}

i64 test_comparison()
{
    i64 x;
    i64 y;

    x = 1;
    y = 2;

    if(y > x & x < y & y >= 2 & x <= 1 & y >= 1 & x <= 2)
    {
        ret 0;
    }
    ret 1;
}

i64 test_equality()
{
    i64 x;
    i64 y;

    x = 1;
    y = 2;

    if(x == 1 & y == 2 & x != 2 & y != 1 & !(x == y))
    {
        ret 0;
    }
    ret 1;
}

i64 test_complex_expression()
{
    i64 x;
    i64 y;
    i64 z;
    i64 w;
    i64 e;
    i64 f;
    i64 g;
    i64 result;

    x = 5;
    y = 2;
    z = 3;
    w = 1;
    e = 3;
    f = 1;
    g = 2;

    i64* px;
    px = &x;

    result = (((*px * y / z + w - 1) << 2) >> 1) & e ^ f | g;
    if(result == 3)
    {
        ret 0;
    }
    ret 1;
}

i64 test_negative()
