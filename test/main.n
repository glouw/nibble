i64 test_defer_6()
{
    i64* v = new i64[32];
    defer del v;
    i64 i = 0;
    i64 j = 0;
    i64* w;
    i64* x;
    i64* y;
    i64* z;
    while(j < 1)
    {
        w = new i64[32];
        defer del w;
        while(i < 512)
        {
            x = new i64[32];
            defer del x;
            y = new i64[32];
            defer del y;
            if(i == 32)
            {
                {
                    z = new i64[32];
                    defer del z;
                    {
                        break;
                    }
                }
            }
            i = i + 1;
        }
        j = j + 1;
    }
    if(i == 32)
    {
        ret 0;
    }
    ret 1;
}

