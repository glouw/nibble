i32 test_defer_5()
{
    i32 elems = 512;
    if(1 == 2)
    {
    }
    else
    if(1 == 1)
    {
        i32* x = new i32[u64 elems];
        defer del x;
        1 == 1;
    }
    else
    {
    }
