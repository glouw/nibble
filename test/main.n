i64 add(i64 a, i64 b)
{
    ret a + b;
}

i64 sub(i64 a, i64 b)
{
    ret a - b;
}

i64 test_function()
{
    if(add(32, add(1, 1)) == 34)
    {
        ret 0;
    }
    ret 1;
}

i64 test_pointers()
{
    i64* p;
    i64** pp;
    i64*** ppp;

    i64 value;
    value = 42;

    p = &value;
    pp = &p;
    ppp = &pp;

    ***ppp = ***ppp - 1;
    **pp = **pp - 1;
    *p = *p - 1;

    if(value == 39)
    {
        ret 0;
    }
    ret 1;
}

i64 test_loop_ret()
{
    i64 i;
    i = 10;
    while(i >= 0)
    {
        if(i == 0)
        {
            ret i;
        }
        i = i - 1;
    }
    ret 1;
}

