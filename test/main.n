//
// these are sentinel tests that were written
// as the nibble compiler was being built.
//
// they serve to prevent regressions.
//

include "../lib/std.n";

// comment

i32 add(i32 a, i32 b)
{
    ret a + b;
}

i32 sub(i32 a, i32 b)
{
    ret a - b;
}

i32 test_function()
{
    if(add(32, add(1, 1)) == 34)
    {
        ret 0;
    }
    ret 1;
}

i32 test_pointers()
{
    i32* p;
    i32** pp;
    i32*** ppp;

    i32 value;
    value = 42;

    p = &value;
    pp = &p;
    ppp = &pp;

    ***ppp = ***ppp - 1;
    **pp = **pp - 1;
    *p = *p - 1;

    if(value == 39)
    {
        ret 0;
    }
    ret 1;
}

i32 test_loop_ret()
{
    i32 i;
    i = 10;
    while(i >= 0)
    {
        if(i == 0)
        {
            ret i;
        }
        i = i - 1;
    }
    ret 1;
}

i32 test_if_0()
{
    if(0 == 0)
    {
        ret 0;
    }
    ret 1;
}

i32 test_if_1()
{
    if(0 == 1)
    {
    }
    else
    {
        ret 0;
    }
    ret 1;
}

i32 test_if_2()
{
    if(0 == 1)
    {
    }
    else if(1 == 1)
    {
        ret 0;
    }
    else
    {
    }
    ret 1;
}

i32 test_if_3()
{
    if(0 == 1)
    {
    }
    else if(2 == 1)
    {
    }
    else if(1 == 1)
    {
        ret 0;
    }
    else
    {
    }
    ret 1;
}

i32 test_if_4()
{
    if(0 == 1)
        ret 1;
    else if(2 == 1)
        ret 1;
    else if(1 == 1)
        ret 0;
    else
        ret 1;
    ret 1;
}

i32 test_nest()
{
    {
        {
            {
                i32 x;
            }
            i32 x;
        }
        i32 x;
    }
    i32 x;
    x = 0;
    ret x;
}

i32 test_recursion(i32 x)
{
    if(x == 0)
    {
        ret 0;
    }
    ret test_recursion(x - 1);
}

void set_to_zero(i32* x)
{
    *x = 0;
    ret;
}

void dont_set_to_zero(i32 x)
{
    x = 42;
    ret;
}

i32 test_pointer_arg_0()
{
    i32 x;
    x = 42;
    set_to_zero(&x);
    ret x;
}

i32 test_pointer_arg_1()
{
    i32 x;
    x = 0;
    dont_set_to_zero(x);
    ret x;
}

i32 test_chain()
{
    i32 x;
    i32 y;
    i32 z;

    x = y = z = 42;

    if(x == 42 & y == 42 & z == 42)
    {
        ret 0;
    }
    ret 1;
}

i32 test_pointer_chain()
{
    i32 x;
    i32 y;
    i32 z;

    i32* px;
    i32* py;
    i32* pz;

    px = &x;
    py = &y;
    pz = &z;

    *px = *py = *pz = 42;

    if(x == 42 & y == 42 & z == 42)
    {
        ret 0;
    }
    ret 1;
}

i32 test_bitwise()
{
    i32 x;
    x = 1 & 2 & 3 & 4;

    i32 y;
    y = 1 | 2 | 3 | 4;

    i32 z;
    z = 1 ^ 2 ^ 3 ^ 4;

    i32 a;
    a = ~255;

    if(x == 0 & y == 7 & z == 4 & a == -256)
    {
        ret 0;
    }
    ret 1;
}

i32 test_shift()
{
    i32 x;
    x = 1 << 8;

    i32 y;
    y = 8;
    y = y >> 1;

    i32 z;
    z = -8;
    z = z >> 1;

    i32 a;
    a = -8;
    a = a << 1;

    if(x == 256 & y == 4 & z == -4 & a == -16)
    {
        ret 0;
    }
    ret 1;
}

i32 test_comparison()
{
    i32 x;
    i32 y;

    x = 1;
    y = 2;

    if(y > x & x < y & y >= 2 & x <= 1 & y >= 1 & x <= 2)
    {
        ret 0;
    }
    ret 1;
}

i32 test_equality()
{
    i32 x;
    i32 y;

    x = 1;
    y = 2;

    if(x == 1 & y == 2 & x != 2 & y != 1 & !(x == y))
    {
        ret 0;
    }
    ret 1;
}

i32 test_complex_expression()
{
    i32 x;
    i32 y;
    i32 z;
    i32 w;
    i32 e;
    i32 f;
    i32 g;
    i32 result;

    x = 5;
    y = 2;
    z = 3;
    w = 1;
    e = 3;
    f = 1;
    g = 2;

    i32* px;
    px = &x;

    result = (((*px * y / z + w - 1) << 2) >> 1) & e ^ f | g;
    if(result == 3)
    {
        ret 0;
    }
    ret 1;
}

i32 test_negative()
{
    i32 x;
    x = -5;
    x = -x;
    x = -x;
    if(x == +5)
    {
        ret 1;
    }
    if(x == 5)
    {
        ret 1;
    }
    if(x == -5)
    {
        ret 0;
    }
    ret 1;
}

i32 test_negative_loop()
{
    i32 loops;
    loops = 0;

    i32 i;
    i = -5;
    while(i < 10)
    {
        loops = loops + 1;
        i = i + 1;
    }

    if(loops == 15)
    {
        ret 0;
    }
    ret 1;
}

i32 test_generic_ptr()
{
    ptr p;
    p = malloc(sizeof i32);

    i32* as = i32* p;

    *as = 42;

    if(*as == 42)
    {
        free(p);
        ret 0;
    }

    free(p);
    ret 1;
}

i32 test_abs()
{
    i32 out;
    out = abs(-1);
    if(out == 1)
    {
        ret 0;
    }
    ret 1;
}

i32 test_bool_param(i1 x, i1 y, i1 z)
{
    if(x & y & z)
    {
        ret 0;
    }
    ret 1;
}

i32 test_array_index()
{
    i32 elems;
    i32 size_per;
    i32* as;

    elems = 4;
    size_per = i32 sizeof *as;
    as = i32* malloc(u64 (elems * size_per));

    as[u64 0] = 1;
    as[u64 1] = 2;
    as[u64 2] = 3;
    as[u64 3] = 4;

    if(as[u64 0] == 1
     & as[u64 1] == 2
     & as[u64 2] == 3
     & as[u64 3] == 4)
    {
        free(ptr as);
        ret 0;
    }

    free(ptr as);
    ret 1;
}

i32 test_array_loop_index()
{
    i32 elems;
    i32 size_per;
    i32* as;
    i32 i;
    i32 sum;
    i32 fill;

    elems = 32;
    size_per = i32 sizeof *as;
    as = i32* malloc(u64 elems * u64 size_per);

    fill = 1;
    i = 0;
    while(i < elems)
    {
        as[u64 i] = fill;
        i = i + 1;
    }

    sum = 0;
    i = 0;
    while(i < elems)
    {
        sum = sum + as[u64 i];
        i = i + 1;
    }

    if(sum == elems * fill)
    {
        free(ptr as);
        ret 0;
    }

    free(ptr as);
    ret 1;
}

i32 test_generic_indirect()
{
    ptr p;
    ptr* pp;
    ptr** ppp;

    pp = &p;
    ppp = &pp;

    **ppp = malloc(u64 4);
    free(**ppp);

    ret 0;
}

type type_size_1 { i1 a; };
type type_size_2 { i8 a; i8 b; };
type type_size_3 { i8 a; i8 b; i8 c; };
type type_size_4 { i8 a; i8 b; i8 c; i8 d; };
type type_size_8 { i32 a; i8 b; };
type type_size_16 { i64 a; i8 b; };
type type_size_16_2 { i64 a; i8 b; i8 c; i8 d; i8 e; };

i32 test_sizeof()
{
    ptr p;
    i1  a;
    i8  b;
    i16 c;
    i32 d;
    i64 e;
    i32* f;
    f = &d;

    if(
       sizeof type_size_1    == u64  1
     & sizeof type_size_2    == u64  2
     & sizeof type_size_3    == u64  3
     & sizeof type_size_8    == u64  8
     & sizeof type_size_16   == u64 16
     & sizeof type_size_16_2 == u64 16
     & sizeof p              == u64  8
     & sizeof a              == u64  1
     & sizeof b              == u64  1
     & sizeof c              == u64  2
     & sizeof d              == u64  4
     & sizeof e              == u64  8
     & sizeof (e)            == u64  8
     & sizeof *f             == u64  4
     & sizeof (*f)           == u64  4
     & sizeof ptr            == u64  8
     & sizeof i1             == u64  1
     & sizeof i8             == u64  1
     & sizeof i16            == u64  2
     & sizeof i32            == u64  4
     & sizeof i64            == u64  8
     & sizeof i8*            == u64  8
     & sizeof i8**           == u64  8
     & sizeof i8***          == u64  8
     )
    {
        ret 0;
    }

    ret 1;
}

i32 test_new()
{
    del new i32;
    del new i32;
    del new i32;
    del new i32;
    del new i32;
    del new i32;
    del new i32;
    del new i32;
    del new i32;
    del new i32;

    i32* x;
    x = new i32;
    *x = 1;
    if(*x == 1)
    {
        del x;
        ret 0;
    }
    del x;
    ret 1;
}

i32 test_new_indirect()
{
    i32* x;
    x = new i32;

    i32** y;
    y = new i32*;

    i32*** z;
    z = new i32**;

    *x = 42;
    *y = x;
    *z = y;

    if(***z == 42)
    {
        del x;
        del y;
        del z;
        ret 0;
    }

    del x;
    del y;
    del z;
    ret 1;
}

i32 test_new_many()
{
    i32 value;
    value = 4;

    i32 elems;
    elems = 512;

    i32 total;
    total = elems * value;

    i32* array;
    array = new i32 [u64 elems];

    i32 sum;

    {
        i32 i;
        while(i < elems)
        {
            array[u64 i] = value;
            i = i + 1;
        }
    }

    {
        i32 i;
        while(i < elems)
        {
            sum = sum + array[u64 i];
            i = i + 1;
        }
    }

    if(sum == total)
    {
        del array;
        ret 0;
    }

    del array;
    ret 1;
}

type zero_t
{
    i32 a;
    i32 b;
    i16 c;
    i8 d;
    i1 e;
};

i32 test_zero_init()
{
    i1 a;
    i8 b;
    i16 c;
    i32 d;
    i32 e;
    ptr p;
    i32* pp;
    i32** ppp;
    i32* pppp;
    zero_t zero;

    if(
       b      == i8   0
     & c      == i16  0
     & d      == i32  0
     & e      == i32  0
     & p      == ptr  0
     & pp     == i32* 0
     & ppp    == i32**0
     & pppp   == i32* 0
     & zero.a == i32  0
     & zero.b == i32  0
     & zero.c == i16  0
     & zero.d == i8   0
    )
    {
        ret 0;
    }
    ret 1;
}

i32 test_init()
{
    i32 elems = 512;
    i32* array = new i32[u64 elems];
    del array;
    ret 0;
}

i32 test_continue()
{
    i32 sum = 0;
    i32 i = 0;
    while(i < 32)
    {
        i = i + 1;
        if(i < 16)
        {
            continue;
        }
        sum = sum + 1;
    }
    if(sum == 17)
    {
        ret 0;
    }
    ret 1;
}

i32 test_break()
{
    i32 i = 0;
    while(i < 512)
    {
        if(i == 32)
        {
            break;
        }
        i = i + 1;
    }
    if(i == 32)
    {
        ret 0;
    }
    ret 1;
}

i32 test_defer_0()
{
    i32 elems = 512;
    i32* x = new i32[u64 elems];
    i32* y = new i32[u64 elems];
    i32* z = new i32[u64 elems];
    defer del x;
    defer del y;
    defer del z;
    1 == 1;
    2 == 2;
    3 == 3;
    4 == 4;
    ret 0;
}

i32 test_defer_1()
{
    i32 elems = 512;
    i32* x = new i32[u64 elems];
    defer del x;
    1 == 1;
    {
        i32* y = new i32[u64 elems];
        defer del y;
        1 == 1;
        {
            {
                {
                    {
                        i32* z = new i32[u64 elems];
                        defer del z;
                        1 == 1;
                        {
                        }
                    }
                }
            }
        }
    }
    ret 0;
}

i32 test_defer_2()
{
    i32 elems = 512;
    if(1 == 1)
    {
        i32* x = new i32[u64 elems];
        defer del x;
        1 == 1;
    }
    else
    {
        i32* y = new i32[u64 elems];
        defer del y;
        1 == 1;
    }
    ret 0;
}

void do_a_thing(i32* array)
{
    ret;
}

i32 test_defer_3()
{
    i32 elems = 512;
    i32* x = new i32[u64 elems];
    defer del x;
