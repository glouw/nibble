{
    i32 i = 0;
    i32* x;
    while(i < 512)
    {
        x = new i32[u64 32];
        defer del x;
        if(i == 32)
        {
            break;
        }
        i = i + 1;
    }
    if(i == 32)
    {
        ret 0;
    }
    ret 1;
}

