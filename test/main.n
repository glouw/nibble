i64* pass_pointer(i64* p)
{
    ret p;
}

i64** pass_pointer_pointer(i64** pp)
{
    ret pp;
}

i64 test_direct_function_deref()
{
    i1 true = 1 == 1;
    i1 false = !true;

    i64* p = new i64;
    defer del p;

    i1 okay = true;

    //
    // ensure functions pointers are lvalue convertable
    //

    *pass_pointer(p) = 42;
    if(*p != 42)
        okay = false;

    **pass_pointer_pointer(&p) = 11;
    if(*p != 11)
        okay = false;

    if(okay)
    {
        ret 0;
    }
    ret 1;
}

type double_t
{
    double value;
};

type int_t
{
    i64 value;
};

type array_t
{
    int_t* value;
};

type blob_t
{
    i32 a;
    i1 c;
    i8 d;
    i16 e;
    i64 f;
    int_t int;
    array_t array;
};

i64 test_type_copy()
{
    blob_t a;
    blob_t b;
    blob_t* p = &a;

    a.f = 42;

    a.int.value = 42;

    int_t other = a.int;

    b = *p;

    blob_t c;
    c.array.value = new int_t[32];
    defer del c.array.value;

    int_t* temp = c.array.value;
    temp[4].value = 42;

    if(a.f == 42
     & b.f == 42
     & other.value == 42
     & a.int.value == 42
     & temp[4].value == 42
     & c.array.value[4].value == 42
     )
    {
        ret 0;
    }

    ret 1;
}

i64 test_type_access()
{
    blob_t* heap = new blob_t;
    defer del heap;

    blob_t stack;

    heap.f = 42; // automatic deref, no need to struggle with ->
    stack.f = 42;

    if(heap.f == 42 & stack.f == 42)
    {
        ret 0;
    }

    ret 1;
}

i64 test_str()
{
    str_t message = str_init("test test test");
    str_t a = str_init(" ");
    str_t b = str_init("this");
    str_t c = str_init(" ");
    str_t d = str_init("\tmessage\nx\nx\nx\n");
    str_t expect = str_init("test test test this \tmessage\nx\nx\nx\n");

    defer str_del(&message);
    defer str_del(&a);
    defer str_del(&b);
    defer str_del(&c);
    defer str_del(&d);
    defer str_del(&expect);

    str_cat(&message, &a);
    str_cat(&message, &b);
    str_cat(&message, &c);
    str_cat(&message, &d);

    if(str_equal(&message, &expect))
    {
        ret 0;
    }
    ret 1;
}

void type_no_change(int_t int)
{
    int.value = 42;
    ret;
}

void type_change(int_t* int)
{
    int.value = 42;
    ret;
}

i64 test_type_pass()
{
    int_t int;
    type_no_change(int);
    if(int.value == 42)
    {
        ret 1;
    }
    type_change(&int);
    if(int.value == 0)
    {
        ret 1;
    }
    ret 0;
}

i64 test_mod()
{
    if(9 % 8 == 1)
    {
        ret 0;
    }
    ret 1;
}

i64 test_postix_increment()
{
    int_t int;
    int.value = 41;
    int.value++;
    i64 x = 41;
    i64 y = x++;

    double_t d;

    if(y == 41
     & x == 42
     & int.value == 42
     & int.value++ == 42
     & d.value++ == 0.0
     & d.value == 1.0
     )
    {
        ret 0;
    }
    ret 1;
}

i64 test_postix_decrement()
{
    int_t int;
    int.value = 43;
    int.value--;
    i64 x = 42;
    i64 y = x--;
    double_t d;
    if(y == 42
     & x == 41
     & int.value == 42
     & d.value-- == 0.0
     & d.value == -1.0
     )
    {
        ret 0;
    }
    ret 1;
}

i64 test_prefix_increment()
{
    int_t int;
    int.value = 41;
    ++int.value;
    i64 x = 41;
    i64 y = ++x;
    double_t d;
    if(y == 42
     & x == 42
     & int.value == 42
     & ++d.value == 1.0
    )
    {
        ret 0;
    }
    ret 1;
}

i64 test_prefix_decrement()
{
    int_t int;
    int.value = 43;
    --int.value;
    i64 x = 43;
    i64 y = --x;
    double_t d;
    if(y == 42
     & x == 42
     & int.value == 42
     & --d.value == -1.0
    )
    {
        ret 0;
    }
    ret 1;
}

void stack_defer_exits(str_t* out)
{
    defer str_cats(out, "A");
    defer str_cats(out, "B");
    defer str_cats(out, "C");
    defer str_cats(out, "D");
    defer str_cats(out, "E");
    ret;
}

i64 test_defer_prints()
{
    str_t out = str_init("");
    stack_defer_exits(&out);
    str_t expect = str_init("EDCBA");
    defer str_del(&out);
    defer str_del(&expect);
    if(str_equal(&out, &expect))
    {
        ret 0;
    }
    ret 1;
}

i64 test_defer_continue()
{
    i64 i;
    while(i < 32)
    {
        defer i++;
        if(i > 16)
        {
            continue;
        }
    }
    if(i == 32)
    {
        ret 0;
    }
    ret 1;
}

i64 test_ascii_char()
{
    if(
       '\a' == <i8>( 7)
     & '\b' == <i8>( 8)
     & '\f' == <i8>(12)
     & '\n' == <i8>(10)
     & '\r' == <i8>(13)
     & '\t' == <i8>( 9)
     & '\v' == <i8>(11)
     & '\\' == <i8>(92)
     & '\'' == <i8>(39)
     & '\"' == <i8>(34)
     &  '"' == <i8>(34)
     & '\?' == <i8>(63)
     & 'A'  == <i8>(65)
     & "\a"[0] == <i8>( 7)
     & "\b"[0] == <i8>( 8)
     & "\f"[0] == <i8>(12)
     & "\n"[0] == <i8>(10)
     & "\r"[0] == <i8>(13)
     & "\t"[0] == <i8>( 9)
     & "\v"[0] == <i8>(11)
     & "\\"[0] == <i8>(92)
     & "\'"[0] == <i8>(39)
     & "\?"[0] == <i8>(63)
     &  "A"[0] == <i8>(65)
    )
    {
        ret 0;
    }
    ret 1;
}

i64
test_double_type_cast()
{
    i64 a = <i64>(42.42);
    i32 b = <i32>(41.42);
    i16 c = <i16>(40.42);
    i8  d =  <i8>(39.42);

    double e = <double>(<i64>(42));
    double f = <double>(<i32>(41));
    double g = <double>(<i16>(40));
    double h = <double>( <i8>(39));

    if(a == 42
     & b == <i32>(41)
     & c == <i16>(40)
     & d == <i8>(39)
     & e == 42.0
     & f == 41.0
     & g == 40.0
     & h == 39.0
    )
    {
        ret 0;
    }
    ret 1;
}

i64
test_double_math()
{
    double x = 1.0;
    double y = 1.0;
    x = y;
    if(x == y
     & 3.0 * 3.0 == 9.0
     & 3.0 / 3.0 == 1.0
     & 3.0 - 3.0 == 0.0
     & 3.0 + 3.0 == 6.0
     & 6.0 > 0.0
     & 6.0 >= 6.0
     & 6.0 <= 6.0
     & 0.0 < 6.0
     & 0.0 <= 6.0
     & 8.0 != 6.0
     & 8.0 == 8.0
    )
    {
        ret 0;
    }
    ret 1;
}

i64
test_float_math()
{
    float x = <float>(1.0);
    float y = <float>(2.0);
    x = y;
    if(x == y
     & <float>(3.0)  * <float>(3.0) == <float>(9.0)
     & <float>(3.0)  / <float>(3.0) == <float>(1.0)
     & <float>(3.0)  - <float>(3.0) == <float>(0.0)
     & <float>(3.0)  + <float>(3.0) == <float>(6.0)
     & <float>(6.0)  > <float>(0.0)
     & <float>(6.0) >= <float>(6.0)
     & <float>(6.0) <= <float>(6.0)
     & <float>(0.0)  < <float>(6.0)
     & <float>(0.0) <= <float>(6.0)
     & <float>(8.0) != <float>(6.0)
     & <float>(8.0) == <float>(8.0)
    )
    {
        ret 0;
    }
    ret 1;
}

i64
test_unsigned()
{
    u8  a =  <u8>(42);
    u16 b = <u16>(42);
    u32 c = <u32>(42);
    u64 d = <u64>(42);

    u8  fa =  <u8>(42.0);
    u16 fb = <u16>(42.0);
    u32 fc = <u32>(42.0);
    u64 fd = <u64>(42.0);

    a =  <u8>(a);
    b = <u16>(b);
    c = <u32>(c);
    d = <u64>(d);

    u8 byte = <u8>(255);
    byte = byte >> <u8>(1);
    byte = byte << <u8>(1);

    byte = byte - <u8>(2);
    byte = byte / <u8>(2);

    if(byte == <u8>(126))
    {
        ret 0;
    }

    ret 1;
}

type point_t
{
    i64 x;
    i64 y;
    i64 z;
    i1 bool;
    int_t int;
    double value;
};

i64
test_aggregate_operations()
{
    point_t a;
    point_t b;
    point_t c;

    a.x = 1;
    a.y = 2;
    a.z = 3;

    b.x = 10;
    b.y = 10;
    b.z = 10;
    b.int.value = 1;

    a = a + b;

    c.x = 11;
    c.y = 12;
    c.z = 13;
    c.int.value = 1;

    a.int = a.int | b.int;

    if(a.x == c.x
     & a.y == c.y
     & a.z == c.z
     & a.int.value == c.int.value
    )
    {
        ret 0;
    }

    ret 1;
}

type value_t
{
    i64 x = 1;
    i64 y = 2;
    i64 z = 3;
};

i64
test_complex_aggregate_operations()
{
    value_t a;
    value_t b;
    value_t* aa = &a;
    value_t* bb = &b;
    *aa = *aa = *bb = *bb + b % b;
    *aa = a + *bb + b / *bb;
    *aa = *aa * *aa;
    if(aa.x == 9
     & aa.y == 25
     & aa.z == 49)
    {
        ret 0;
    }
    ret 1;
}

type default_internal_internal_init_t
{
    i64 x = 11;
    i64 y = 12;
    i64 z = 13;
};

type default_internal_init_t
{
    i64 x = 88;
    i64 y = 48;
    default_internal_internal_init_t internal;
    i64 z = 28;
};

type default_init_t
{
    i64 x = 0;
    i64 y = 1;
    i64 z = 2;
    default_internal_init_t internal;
    double a = 2.0;
    float b = 1.0;
    u1 c = 1;
    i1 d = 1;
};

i64 test_default_type_init()
{
    default_init_t init;
    if(init.x == 0
     & init.y == 1
     & init.z == 2
     & init.internal.x == 88
     & init.internal.y == 48
     & init.internal.z == 28
     & init.internal.internal.x == 11
     & init.internal.internal.y == 12
     & init.internal.internal.z == 13
     & init.a == <double>(2.0)
     & init.b == <float>(1.0)
     & init.c == <u1>(1)
     & init.d == <i1>(1)
    )
    {
        ret 0;
    }
    ret 1;
}

i64 test_boolean_type_cast()
{
    u1 okay = <u1>(<i1>(<u1>(<i16>(<u16>(<i32>(<u32>(<i64>(<u64>(1)))))))));
    while(okay)
    {
        break;
    }
    if(okay)
    {
        ret 0;
    }
    ret 1;
}

i64 call_indirect(i64() f, i64 x, i64 y)
{
    ret f(x, y);
}

i64 test_function_pointer()
{
    if(call_indirect(add, 1, 2) == 3
     & call_indirect(sub, 8, 2) == 6
     & call_indirect(<i64()>(add), 1, 2) == 3
     & call_indirect(<i64()>(sub), 8, 2) == 6)
    {
        ret 0;
    }
    ret 1;
}

i64 test_conversion()
{
    i1 okay = <i1>(1);
    i64 x = 18446744073709551615;
    u64 y = <u64>(18446744073709551615);
    u32 z = <u32>(4294967295);
    if(x != 18446744073709551615)
    {
        okay = okay & <i1>(0);
    }
    if(<u64>(x) != <u64>(18446744073709551615))
    {
        okay = okay & <i1>(0);
    }
    if(<i64>(y) != <i64>(18446744073709551615))
    {
        okay = okay & <i1>(0);
    }
    if(<u32>(z) != <u32>(18446744073709551615))
    {
        okay = okay & <i1>(0);
    }
    if(okay)
    {
        ret 0;
    }
    ret 1;
}

i32 compare_i64(i64* left, i64* rite)
{
    ret <i32>(*left > *rite);
}

type pointer_in_type_t
{
    i64() add;
};

i64 test_pointer_in_type()
{
    pointer_in_type_t self;
    self.add = add;
    i64 out = self.add(1, 2);
    if(out == 3 & self.add(1, 2) == 3)
    {
        ret 0;
    }
    ret 1;
}

i64 test_qsort()
{
    i64 size = 4;
    i64* array = new i64[size];
    defer del array;
    array[0] = 9;
    array[1] = 3;
    array[2] = 1;
    array[3] = 8;
    qsort(<ptr>(array), <u64>(size), sizeof *array, compare_i64);
    if(array[0] == 1
     & array[1] == 3
     & array[2] == 8
     & array[3] == 9)
    {
        ret 0;
    }
    ret 1;
}

i8* ret_string()
{
    ret "test";
}

i64 test_string_return()
{
    if(strcmp(ret_string(), "test") == <i32>(0))
    {
        ret 0;
    }
    ret 1;
}

i64 test_variadic_function_pointer()
{
    i32...() s = sprintf;
    i8* buffer = new i8[32];
    defer del buffer;
    s(buffer, "test%d", 42);
    if(strcmp(buffer, "test42") == <i32>(0))
    {
        ret 0;
    }
    ret 1;
}

i32 main()
{
    i64 result =
        test_function()
      | test_pointers()
      | test_if_0()
      | test_if_1()
      | test_if_2()
      | test_if_3()
      | test_if_4()
      | test_nest()
      | test_loop_ret()
      | test_recursion(8)
      | test_pointer_arg_0()
      | test_pointer_arg_1()
      | test_chain()
      | test_pointer_chain()
      | test_bitwise()
      | test_shift()
      | test_comparison()
      | test_equality()
      | test_complex_expression()
      | test_negative()
      | test_negative_loop()
      | test_generic_ptr()
      | test_llabs()
      | test_bool_param(1 == 1, 2 == 2, 3 == 3)
      | test_array_index()
      | test_array_loop_index()
      | test_generic_indirect()
      | test_sizeof()
      | test_new()
      | test_new_indirect()
      | test_new_many()
      | test_zero_init()
      | test_continue()
      | test_break()
      | test_defer_0()
      | test_defer_1()
      | test_defer_2()
      | test_defer_3()
      | test_defer_4()
      | test_defer_5()
      | test_defer_6()
      | test_defer_7()
      | test_defer_8()
      | test_defer_9()
      | test_defer_10(10)
      | test_2d_array()
      | test_types()
      | test_direct_function_deref()
      | test_type_copy()
      | test_type_access()
      | test_str()
      | test_type_pass()
      | test_mod()
      | test_postix_increment()
      | test_postix_decrement()
      | test_prefix_increment()
      | test_prefix_decrement()
      | test_defer_prints()
      | test_defer_continue()
      | test_ascii_char()
      | test_double_type_cast()
      | test_double_math()
      | test_float_math()
      | test_unsigned()
      | test_aggregate_operations()
      | test_default_type_init()
      | test_boolean_type_cast()
      | test_complex_aggregate_operations()
      | test_function_pointer()
      | test_conversion()
      | test_qsort()
      | test_pointer_in_type()
      | test_string_return()
      | test_variadic_function_pointer()
    ;
    if(result == 0)
    {
        ret <i32>(0);
    }
    ret <i32>(1);
}
