}

i64 test_negative_loop()
{
    i64 loops;
    loops = 0;

    i64 i;
    i = -5;
    while(i < 10)
    {
        loops = loops + 1;
        i = i + 1;
    }

    if(loops == 15)
    {
        ret 0;
    }
    ret 1;
}

i64 test_generic_ptr()
{
    ptr p;
    p = malloc(sizeof i64);

    i64* as;
    as = <i64*>(p);

    *as = 42;

    if(*as == 42)
    {
        free(p);
        ret 0;
    }

    free(p);
    ret 1;
}

