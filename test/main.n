i32 test_defer_9()
{
    i32 i = 0;
    i32* x;
    while(i < 512)
    {
        if(i == 32)
        {
            x = new i32[u64 32];
            defer del x;
            break;
        }
        i = i + 1;
    }
    if(i == 32)
    {
        ret 0;
    }
    ret 1;
}

i32 test_defer_10(i32 loops)
{
    i32* x = new i32[u64 32];
    *x = loops;
    defer del x;
    if(loops == 0)
    {
        ret 0;
    }
    else
    {
        ret test_defer_10(loops - 1);
    }
    ret -1;
}

i32** new_2d_array(i32 ysize, i32 xsize)
{
    i32** y = new i32*[u64 ysize];
    i32 i = 0;
    while(i < ysize)
    {
        y[u64 i] = new i32[u64 xsize];
        i = i + 1;
    }
    y[u64 0][u64 0] = y[u64 0][u64 0];
    ret y;
}

void del_2d_array(i32** array, i32 ysize)
{
    i32 i = 0;
    while(i < ysize)
    {
        del array[u64 i];
        i = i + 1;
    }
    del array;
    ret;
}

i32 test_2d_array()
{
    i32 ysize = 128;
    i32 xsize = 32;
    i32** array = new_2d_array(ysize, xsize);
    defer del_2d_array(array, ysize);
    ret 0;
}

type type_a
{
    i32 a;
    i32 b;
    i8 c;
};

type type_b
{
    type_a a;
    i32 b;
};

type type_c
{
    type_a a;
    type_b b;
    i32 c;
    i32 d;
    i8 e;
    i1 f;
};

i32 test_types()
{
    type_c stack;
    type_c* heap = new type_c;
    type_c* heaps = new type_c[u64 32];
    defer del heap;
    defer del heaps;
    ret 0;
}

i32* pass_pointer(i32* p)
{
    ret p;
}

i32** pass_pointer_pointer(i32** pp)
{
    ret pp;
}

i32 test_direct_function_deref()
{
    i1 true = 1 == 1;
    i1 false = !true;

    i32* p = new i32;
    defer del p;

    i1 okay = true;

    //
    // ensure functions pointers are lvalue convertable
    //

    *pass_pointer(p) = 42;
    if(*p != 42)
        okay = false;

    **pass_pointer_pointer(&p) = 11;
    if(*p != 11)
        okay = false;

    if(okay)
    {
        ret 0;
    }
    ret 1;
}

type f64_t
{
    f64 value;
};

type int_t
{
    i32 value;
};

type array_t
{
    int_t* value;
};

type blob_t
{
    i32 a;
    i1 c;
    i8 d;
    i16 e;
    i32 f;
    int_t int;
    array_t array;
};

i32 test_type_copy()
{
    blob_t a;
    blob_t b;
    blob_t* p = &a;

    a.f = 42;

    a.int.value = 42;

    int_t other = a.int;

    b = *p;

    blob_t c;
    c.array.value = new int_t[u64 32];
    defer del c.array.value;

    int_t* temp = c.array.value;
    temp[u64 4].value = 42;

    if(a.f == 42
     & b.f == 42
     & other.value == 42
     & a.int.value == 42
     & temp[u64 4].value == 42
     & c.array.value[u64 4].value == 42
     )
    {
        ret 0;
    }

    ret 1;
}

i32 test_type_access()
{
    blob_t* heap = new blob_t;
    defer del heap;

    blob_t stack;

    heap.f = 42; // automatic deref, no need to struggle with ->
    stack.f = 42;

    if(heap.f == 42 & stack.f == 42)
    {
        ret 0;
    }

    ret 1;
}

void type_no_change(int_t int)
{
    int.value = 42;
    ret;
}

void type_change(int_t* int)
{
    int.value = 42;
    ret;
}

i32 test_type_pass()
{
    int_t int;
    type_no_change(int);
    if(int.value == 42)
    {
        ret 1;
    }
    type_change(&int);
    if(int.value == 0)
    {
        ret 1;
    }
    ret 0;
}

i32 test_mod()
{
    if(9 % 8 == 1)
    {
        ret 0;
    }
    ret 1;
}

i32 test_postix_increment()
{
    int_t int;
    int.value = 41;
    int.value++;
    i32 x = 41;
    i32 y = x++;

    f64_t d;

    if(y == 41
     & x == 42
     & int.value == 42
     & int.value++ == 42
     & d.value++ == 0.0
     & d.value == 1.0
     )
    {
        ret 0;
    }
    ret 1;
}

i32 test_postix_decrement()
{
    int_t int;
    int.value = 43;
    int.value--;
    i32 x = 42;
    i32 y = x--;
    f64_t d;
    if(y == 42
     & x == 41
     & int.value == 42
     & d.value-- == 0.0
     & d.value == -1.0
     )
    {
        ret 0;
    }
    ret 1;
}

i32 test_prefix_increment()
{
    int_t int;
    int.value = 41;
    ++int.value;
    i32 x = 41;
    i32 y = ++x;
    f64_t d;
    if(y == 42
     & x == 42
     & int.value == 42
     & ++d.value == 1.0
    )
    {
        ret 0;
    }
    ret 1;
}

i32 test_prefix_decrement()
{
    int_t int;
    int.value = 43;
    --int.value;
    i32 x = 43;
    i32 y = --x;
    f64_t d;
    if(y == 42
     & x == 42
     & int.value == 42
     & --d.value == -1.0
    )
    {
        ret 0;
    }
    ret 1;
}

i32 test_defer_continue()
{
    i32 i;
    while(i < 32)
    {
        defer i++;
        if(i > 16)
        {
            continue;
        }
    }
    if(i == 32)
    {
        ret 0;
    }
    ret 1;
}

i32 test_ascii_char()
{
    if(
       '\a'    == i8  7
     & '\b'    == i8  8
     & '\f'    == i8 12
     & '\n'    == i8 10
     & '\r'    == i8 13
     & '\t'    == i8  9
     & '\v'    == i8 11
     & '\\'    == i8 92
     & '\''    == i8 39
     & '\"'    == i8 34
     &  '"'    == i8 34
     & '\?'    == i8 63
     & 'A'     == i8 65
     & "\a"[u64 0] == i8  7
     & "\b"[u64 0] == i8  8
     & "\f"[u64 0] == i8 12
     & "\n"[u64 0] == i8 10
     & "\r"[u64 0] == i8 13
     & "\t"[u64 0] == i8  9
     & "\v"[u64 0] == i8 11
     & "\\"[u64 0] == i8 92
     & "\'"[u64 0] == i8 39
     & "\?"[u64 0] == i8 63
     &  "A"[u64 0] == i8 65
    )
    {
        ret 0;
    }
    ret 1;
}

i32
test_f64_type_cast()
{
    i32 a = i32 42.42;
    i32 b = i32 41.42;
    i16 c = i16 40.42;
    i8  d =  i8 39.42;

    f64 e = f64 i32 42;
    f64 f = f64 i32 41;
    f64 g = f64 i16 40;
    f64 h = f64  i8 39;

    if(a == 42
     & b == i32 41
     & c == i16 40
     & d ==  i8 39
     & e == 42.0
     & f == 41.0
     & g == 40.0
     & h == 39.0
    )
    {
        ret 0;
    }
    ret 1;
}

i32
test_f64_math()
{
    f64 x = 1.0;
    f64 y = 1.0;
    x = y;
    if(x == y
     & 3.0 * 3.0 == 9.0
     & 3.0 / 3.0 == 1.0
     & 3.0 - 3.0 == 0.0
     & 3.0 + 3.0 == 6.0
     & 6.0 > 0.0
     & 6.0 >= 6.0
     & 6.0 <= 6.0
     & 0.0 < 6.0
     & 0.0 <= 6.0
     & 8.0 != 6.0
     & 8.0 == 8.0
    )
    {
        ret 0;
    }
    ret 1;
}

i32
test_f32_math()
{
    f32 x = f32 1.0;
    f32 y = f32 2.0;
    x = y;
    if(x == y
     & f32 3.0  * f32 3.0 == f32 9.0
     & f32 3.0  / f32 3.0 == f32 1.0
     & f32 3.0  - f32 3.0 == f32 0.0
     & f32 3.0  + f32 3.0 == f32 6.0
     & f32 6.0  > f32 0.0
     & f32 6.0 >= f32 6.0
     & f32 6.0 <= f32 6.0
     & f32 0.0  < f32 6.0
     & f32 0.0 <= f32 6.0
     & f32 8.0 != f32 6.0
     & f32 8.0 == f32 8.0
    )
    {
        ret 0;
    }
    ret 1;
}

i32
test_unsigned()
{
    u8  a =  u8 42;
    u16 b = u16 42;
    u32 c = u32 42;
    u64 d = u64 42;

    u8  fa =  u8 42.0;
    u16 fb = u16 42.0;
    u32 fc = u32 42.0;
    u64 fd = u64 42.0;

    a =  u8 a;
    b = u16 b;
    c = u32 c;
    d = u64 d;

    u8 byte = u8 255;
    byte = byte >> u8 1;
    byte = byte << u8 1;

    byte = byte - u8 2;
    byte = byte / u8 2;

    if(byte == u8 126)
    {
        ret 0;
    }

    ret 1;
}

type point_t
{
    i32 x;
    i32 y;
    i32 z;
    i1 bool;
    int_t int;
    f64 value;
};

i32
test_aggregate_operations()
{
    point_t a;
    point_t b;
    point_t c;

    a.x = 1;
    a.y = 2;
    a.z = 3;

    b.x = 10;
    b.y = 10;
    b.z = 10;
    b.int.value = 1;

    a = a + b;

    c.x = 11;
    c.y = 12;
    c.z = 13;
    c.int.value = 1;

    a.int = a.int | b.int;

    if(a.x == c.x
     & a.y == c.y
     & a.z == c.z
     & a.int.value == c.int.value
    )
    {
        ret 0;
    }

    ret 1;
}

type value_t
{
    i32 x = 1;
    i32 y = 2;
    i32 z = 3;
};

i32
test_complex_aggregate_operations()
{
    value_t a;
    value_t b;
    value_t* aa = &a;
    value_t* bb = &b;
    *aa = *aa = *bb = *bb + b % b;
    *aa = a + *bb + b / *bb;
    *aa = *aa * *aa;
    if(aa.x == 9
     & aa.y == 25
     & aa.z == 49)
    {
        ret 0;
    }
    ret 1;
}

type default_internal_internal_init_t
{
    i32 x = 11;
    i32 y = 12;
    i32 z = 13;
};

type default_internal_init_t
{
    i32 x = 88;
    i32 y = 48;
    default_internal_internal_init_t internal;
    i32 z = 28;
};

type default_init_t
{
    i32 x = 0;
    i32 y = 1;
    i32 z = 2;
    default_internal_init_t internal;
    f64 a = 2.0;
    u1 c = 1;
    i1 d = 1;
};

i32 test_default_type_init()
{
    default_init_t init;
    if(init.x == 0
     & init.y == 1
     & init.z == 2
     & init.internal.x == 88
     & init.internal.y == 48
     & init.internal.z == 28
     & init.internal.internal.x == 11
     & init.internal.internal.y == 12
     & init.internal.internal.z == 13
     & init.a == f64 2.0
     & init.c == u1 1
     & init.d == i1 1
    )
    {
        ret 0;
    }
    ret 1;
}

i32 test_boolean_type_cast()
{
    u1 okay = u1 i1 u1 i16 u16 i32 u32 i32 u64 1;
    while(okay)
    {
        break;
    }
    if(okay)
    {
        ret 0;
    }
    ret 1;
}

i32 call_indirect(i32() f, i32 x, i32 y)
{
    ret f(x, y);
}

i32 test_function_pointer()
{
    if(call_indirect(add, 1, 2) == 3
     & call_indirect(sub, 8, 2) == 6
     & call_indirect(i32() add, 1, 2) == 3
     & call_indirect(i32() sub, 8, 2) == 6)
    {
        ret 0;
    }
    ret 1;
}

i32 test_conversion()
{
    i1 okay = i1 1;
    i32 x = 18446744073709551615;
    u64 y = u64 18446744073709551615;
    u32 z = u32 4294967295;
    if(x != 18446744073709551615)
    {
        okay = okay & i1 0;
    }
    if(u64 x != u64 18446744073709551615)
    {
        okay = okay & i1 0;
    }
    if(i32 y != i32 18446744073709551615)
    {
        okay = okay & i1 0;
    }
    if(u32 z != u32 18446744073709551615)
    {
        okay = okay & i1 0;
    }
    if(okay)
    {
        ret 0;
    }
    ret 1;
}

i32 compare_i32(i32* left, i32* rite)
{
    ret i32 (*left > *rite);
}

type pointer_in_type_t
{
    i32() add;
};

i32 test_pointer_in_type()
{
    pointer_in_type_t self;
    self.add = add;
    i32 out = self.add(1, 2);
    if(out == 3 & self.add(1, 2) == 3)
    {
        ret 0;
    }
    ret 1;
}

i32 test_qsort()
{
    i32 size = 4;
    i32* array = new i32[u64 size];
    defer del array;
    array[u64 0] = 9;
    array[u64 1] = 3;
    array[u64 2] = 1;
    array[u64 3] = 8;
    qsort(ptr array, u64 size, sizeof *array, compare_i32);
    if(array[u64 0] == 1
     & array[u64 1] == 3
     & array[u64 2] == 8
     & array[u64 3] == 9)
    {
        ret 0;
    }
    ret 1;
}

i8* ret_string()
{
    ret "test";
}

i32 test_string_return()
{
    if(strcmp(ret_string(), "test") == i32 0)
    {
        ret 0;
    }
    ret 1;
}

i32 test_variadic_function_pointer()
{
    i32...() s = sprintf;
    i8* buffer = new i8[u64 32];
    defer del buffer;
    s(buffer, "test%d", 42);
    if(strcmp(buffer, "test42") == i32 0)
    {
        ret 0;
    }
    ret 1;
}

i32 test_type_cast_postfix_access()
{
    i32* array = new i32[u64 32];
    defer del array;
    array[u64 0] = 42;
    if(array[u64 0] == 42)
    {
        ret 0;
    }
    ret 1;
}

int_t ret_copy(int_t integer)
{
    ret integer;
}

int_t* ret_pointer(int_t* integer)
{
    ret integer;
}

i32 test_type_cast_postfix_function()
{
    int_t integer;
    integer.value = 42;
    if(ret_copy(integer).value == 42 & ret_pointer(&integer).value == 42)
    {
        ret 0;
    }
    ret 1;
}

void i32_delete(i32* self)
{
    *self = 0;
    ret;
}

i32 test_arr_t()
{
    arr_t arr = arr_init(u64 4, sizeof i32, i32_delete);
    defer arr_del(&arr);
    u64 index;
    while(index < arr.size)
    {
        * i32* arr_at(&arr, index) = i32 index;
        index++;
    }
    i1 okay = i1 1;
    okay = okay & *i32* arr_at(&arr, u64 0) == 0;
    okay = okay & *i32* arr_at(&arr, u64 1) == 1;
    okay = okay & *i32* arr_at(&arr, u64 2) == 2;
    okay = okay & *i32* arr_at(&arr, u64 3) == 3;
    arr_del_elems(&arr);
    okay = okay & *i32* arr_at(&arr, u64 0) == 0;
    okay = okay & *i32* arr_at(&arr, u64 1) == 0;
    okay = okay & *i32* arr_at(&arr, u64 2) == 0;
    okay = okay & *i32* arr_at(&arr, u64 3) == 0;
    if(okay)
    {
        ret 0;
    }
    ret 1;
}

void stack_defer_exits(str_t* str )
{
    defer str_cat(str, "A");
    defer str_cat(str, "B");
    defer str_cat(str, "C");
    defer str_cat(str, "D");
    defer str_cat(str, "E");
    ret;
}

i32 test_defer_prints()
{
    str_t str = str_init("");
    stack_defer_exits(&str);
    defer str_del(&str);
    if(str_equal(&str, "EDCBA"))
    {
        ret 0;
    }
    ret 1;
}

i32 test_str_push()
{
    str_t str = str_init("");
    str_push(&str, 'A');
    void() pppppppp = str_push;
    pppppppp(&str, 'B');
    str_push(&str, 'C');
    str_push(&str, 'D');
    str_push(&str, 'E');
    defer str_del(&str);
    if(str_equal(&str, "ABCDE"))
    {
        ret 0;
    }
    ret 1;
}

type person_t
{
    f64 height;
};

person_t* ret_person_pointer(person_t* self)
{
    ret self;
}

i32 test_person_modify()
{
    person_t person;
    person.height = 42.0;
    ++ (person_t*() ret_person_pointer)(&person).height    ;
    -- (person_t*() ret_person_pointer)(&person).height    ;
       (person_t*() ret_person_pointer)(&person).height ++ ;
       (person_t*() ret_person_pointer)(&person).height -- ;
    if(person.height == 42.0)
    {
        ret 0;
    }
    ret 1;
}

i32 main()
{
    i32 result =
        test_function()
      | test_pointers()
      | test_if_0()
      | test_if_1()
      | test_if_2()
      | test_if_3()
      | test_if_4()
      | test_nest()
      | test_loop_ret()
      | test_recursion(8)
      | test_pointer_arg_0()
      | test_pointer_arg_1()
      | test_chain()
      | test_pointer_chain()
      | test_bitwise()
      | test_shift()
      | test_comparison()
      | test_equality()
      | test_complex_expression()
      | test_negative()
      | test_negative_loop()
      | test_generic_ptr()
      | test_abs()
      | test_bool_param(1 == 1, 2 == 2, 3 == 3)
      | test_array_index()
      | test_array_loop_index()
      | test_generic_indirect()
      | test_sizeof()
      | test_new()
      | test_new_indirect()
      | test_new_many()
      | test_zero_init()
      | test_continue()
      | test_break()
      | test_defer_0()
      | test_defer_1()
      | test_defer_2()
      | test_defer_3()
      | test_defer_4()
      | test_defer_5()
      | test_defer_6()
      | test_defer_7()
      | test_defer_8()
      | test_defer_9()
      | test_defer_10(10)
      | test_2d_array()
      | test_types()
      | test_direct_function_deref()
      | test_type_copy()
      | test_type_access()
      | test_type_pass()
      | test_mod()
      | test_postix_increment()
      | test_postix_decrement()
      | test_prefix_increment()
      | test_prefix_decrement()
      | test_defer_continue()
      | test_ascii_char()
      | test_f64_type_cast()
      | test_f64_math()
      | test_f32_math()
      | test_unsigned()
      | test_aggregate_operations()
      | test_default_type_init()
      | test_boolean_type_cast()
      | test_complex_aggregate_operations()
      | test_function_pointer()
      | test_conversion()
      | test_qsort()
      | test_pointer_in_type()
      | test_string_return()
      | test_variadic_function_pointer()
      | test_type_cast_postfix_access()
      | test_type_cast_postfix_function()
      | test_arr_t()
      | test_defer_prints()
      | test_str_push()
      | test_person_modify()
    ;
    if(result == 0)
    {
        ret i32 0;
    }
    ret i32 1;
}
