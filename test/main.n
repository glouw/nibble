i64 test_zero_init()
{
    i1 a;
    i8 b;
    i16 c;
    i64 d;
    i64 e;
    ptr p;
    i64* pp;
    i64** ppp;
    i64* pppp;
    zero_t zero;

    if(
       b == <i8>(0)
     & c == <i16>(0)
     & d == <i64>(0)
     & e == <i64>(0)
     & p == <ptr>(0)
     & pp == <i64*>(0)
     & ppp == <i64**>(0)
     & pppp == <i64*>(0)
     & zero.a == <i64>(0)
     & zero.b == <i32>(0)
     & zero.c == <i16>(0)
     & zero.d == <i8>(0)
    )
    {
        ret 0;
    }
    ret 1;
}

