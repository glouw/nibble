i64 test_array_index()
{
    i64 elems;
    i64 size_per;
    i64* as;

    elems = 4;
    size_per = <i64>(sizeof *as);
    as = <i64*>(malloc(<u64>(elems * size_per)));

    as[0] = 1;
    as[1] = 2;
    as[2] = 3;
    as[3] = 4;

    if(as[0] == 1
     & as[1] == 2
     & as[2] == 3
     & as[3] == 4)
    {
        free(<ptr>(as));
        ret 0;
    }

    free(<ptr>(as));
    ret 1;
}

i64 test_array_loop_index()
{
    i64 elems;
    i64 size_per;
    i64* as;
    i64 i;
    i64 sum;
    i64 fill;

    elems = 32;
    size_per = <i64>(sizeof *as);
    as = <i64*>(malloc(<u64>(elems * size_per)));

    fill = 1;
    i = 0;
    while(i < elems)
    {
        as[i] = fill;
        i = i + 1;
    }

    sum = 0;
    i = 0;
    while(i < elems)
    {
        sum = sum + as[i];
        i = i + 1;
    }

    if(sum == elems * fill)
    {
        free(<ptr>(as));
        ret 0;
    }

    free(<ptr>(as));
    ret 1;
}

i64 test_generic_indirect()
{
    ptr p;
    ptr* pp;
    ptr** ppp;

    pp = &p;
    ppp = &pp;

    **ppp = malloc(<u64>(4));
    free(**ppp);

    ret 0;
}

type type_size_1 { i1 a; };
type type_size_2 { i8 a; i8 b; };
type type_size_3 { i8 a; i8 b; i8 c; };
type type_size_4 { i8 a; i8 b; i8 c; i8 d; };
type type_size_8 { i32 a; i8 b; };
type type_size_16 { i64 a; i8 b; };
type type_size_16_2 { i64 a; i8 b; i8 c; i8 d; i8 e; };

i64 test_sizeof()
{
    ptr p;
    i1  a;
    i8  b;
    i16 c;
    i32 d;
    i64 e;
    i32* f;
    f = &d;

    if(
       sizeof type_size_1    == <u64>( 1)
     & sizeof type_size_2    == <u64>( 2)
     & sizeof type_size_3    == <u64>( 3)
     & sizeof type_size_8    == <u64>( 8)
     & sizeof type_size_16   == <u64>(16)
     & sizeof type_size_16_2 == <u64>(16)
     & sizeof p              == <u64>( 8)
     & sizeof a              == <u64>( 1)
     & sizeof b              == <u64>( 1)
     & sizeof c              == <u64>( 2)
     & sizeof d              == <u64>( 4)
     & sizeof e              == <u64>( 8)
     & sizeof (e)            == <u64>( 8)
     & sizeof *f             == <u64>( 4)
     & sizeof (*f)           == <u64>( 4)
     & sizeof ptr            == <u64>( 8)
     & sizeof i1             == <u64>( 1)
     & sizeof i8             == <u64>( 1)
     & sizeof i16            == <u64>( 2)
     & sizeof i32            == <u64>( 4)
     & sizeof i64            == <u64>( 8)
     & sizeof i8*            == <u64>( 8)
     & sizeof i8**           == <u64>( 8)
     & sizeof i8***          == <u64>( 8)
     )
    {
        ret 0;
    }

    ret 1;
}

i64 test_new()
{
    del new i64;
    del new i64;
    del new i64;
    del new i64;
    del new i64;
    del new i64;
    del new i64;
    del new i64;
    del new i64;
    del new i64;

    i64* x;
    x = new i64;
    *x = 1;
    if(*x == 1)
    {
        del x;
        ret 0;
    }
    del x;
    ret 1;
}

i64 test_new_indirect()
{
    i64* x;
    x = new i64;

    i64** y;
    y = new i64*;

    i64*** z;
    z = new i64**;

    *x = 42;
    *y = x;
    *z = y;

    if(***z == 42)
    {
        del x;
        del y;
        del z;
        ret 0;
    }

    del x;
    del y;
    del z;
    ret 1;
}

i64 test_new_many()
{
    i64 value;
    value = 4;

    i64 elems;
    elems = 512;

    i64 total;
    total = elems * value;

    i64* array;
    array = new i64 [elems];

    i64 sum;

    {
        i64 i;
        while(i < elems)
        {
            array[i] = value;
            i = i + 1;
        }
    }

    {
        i64 i;
        while(i < elems)
        {
            sum = sum + array[i];
            i = i + 1;
        }
    }

    if(sum == total)
    {
        del array;
        ret 0;
    }

    del array;
    ret 1;
}

type zero_t
