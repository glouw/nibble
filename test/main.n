i64 test_continue()
{
    i64 sum = 0;
    i64 i = 0;
    while(i < 32)
    {
        i = i + 1;
        if(i < 16)
        {
            continue;
        }
        sum = sum + 1;
    }
    if(sum == 17)
    {
        ret 0;
    }
    ret 1;
}

