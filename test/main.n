i32 test_defer_6()
{
    i32* v = new i32[u64 32];
    defer del v;
    i32 i = 0;
    i32 j = 0;
    i32* w;
    i32* x;
    i32* y;
    i32* z;
    while(j < 1)
    {
        w = new i32[u64 32];
        defer del w;
        while(i < 512)
        {
            x = new i32[u64 32];
            defer del x;
            y = new i32[u64 32];
            defer del y;
            if(i == 32)
            {
                {
                    z = new i32[u64 32];
                    defer del z;
                    {
                        break;
                    }
                }
            }
            i = i + 1;
        }
        j = j + 1;
    }
    if(i == 32)
    {
        ret 0;
    }
    ret 1;
}

